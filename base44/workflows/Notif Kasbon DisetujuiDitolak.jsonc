{
  "name": "Notif Kasbon Disetujui/Ditolak",
  "description": "Saat status Kasbon berubah ke approved atau rejected, kirim notif ke karyawan",
  "trigger": {
    "condition": "${ (.trigger.changed_fields | index(\"status\") != null) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Kasbon"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "notif_kasbon_disetujui_ditolak",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "onKasbonCreated",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "onKasbonCreated"
  }
}