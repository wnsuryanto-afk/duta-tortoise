{
  "name": "WA Notif: Tool Request Baru",
  "description": "Saat ToolRequest baru dibuat, kirim WhatsApp ke Owner + Manajer",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "ToolRequest"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "wa_notif_tool_request_baru",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "onToolRequestCreated",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "onToolRequestCreated"
  }
}