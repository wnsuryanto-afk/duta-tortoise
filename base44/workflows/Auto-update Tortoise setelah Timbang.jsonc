{
  "name": "Auto-update Tortoise setelah Timbang",
  "description": "Setiap MeasurementHistory baru disimpan, otomatis update last_weighed_date, weight_grams, shell_length_cm di entity Tortoise",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "MeasurementHistory"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_update_tortoise_setelah_timbang",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "onMeasurementSaved",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "onMeasurementSaved"
  }
}