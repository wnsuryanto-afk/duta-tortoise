{
  "name": "Auto Finance dari Health Record",
  "description": "Saat HealthRecord dibuat/diupdate dengan biaya_obat > 0, otomatis buat FinanceTransaction pengeluaran obat_perawatan",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "HealthRecord"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_finance_dari_health_record",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "onHealthRecordSaved",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "onHealthRecordSaved"
  }
}