{
  "name": "Auto: Penjualan \u2192 Laporan Keuangan",
  "description": "Setiap penjualan baru otomatis masuk sebagai pemasukan di laporan keuangan",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Sale"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_penjualan_laporan_keuangan",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "onSaleCreated",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "onSaleCreated"
  }
}