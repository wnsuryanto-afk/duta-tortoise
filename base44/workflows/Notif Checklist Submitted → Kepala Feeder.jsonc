{
  "name": "Notif Checklist Submitted \u2192 Kepala Feeder",
  "description": "Saat DailyChecklist status berubah ke submitted, kirim notif ke semua kepala_feeder",
  "trigger": {
    "condition": "${ (.trigger.data.status == \"submitted\") }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "DailyChecklist"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "notif_checklist_submitted_kepala_feeder",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "onDailyChecklistSubmitted",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "onDailyChecklistSubmitted"
  }
}