{
  "name": "Batalkan Tugas Perawatan Saat Kura Sembuh/Mati",
  "description": "Saat kura sembuh (is_currently_sick false) atau mati (status=mati), batalkan IncidentalTask pending terkait",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"is_currently_sick\") != null) or (.trigger.changed_fields | index(\"status\") != null)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Tortoise"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "batalkan_tugas_perawatan_saat_kura_sembuh_mati",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "onTortoiseStatusChange",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "onTortoiseStatusChange"
  }
}