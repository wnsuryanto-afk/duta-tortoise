{
  // Automation DIMATIKAN 01-09-2026 atas permintaan Iwan (is_active: false).
  //
  // Jadwal ini memanggil pada 17:30 UTC = 00:30 WIB, sementara penjaga jam di
  // dalam fungsinya menolak jam segitu — jadi sejak 27-08-2026 ia menyala tiap
  // hari tanpa pernah mengirim apa pun. Pengingatnya sekarang dipicu saat
  // aplikasi dibuka (lihat src/lib/AuthContext.jsx).
  //
  // Berkas ini ditarik dari server dengan 'base44 functions pull' dan dikirim
  // balik dengan 'base44 functions deploy'. Kolom "entry" SENGAJA relatif
  // terhadap folder ini ("entry.ts"); pull menuliskannya sebagai jalur penuh
  // dari akar app, dan bentuk itu membuat deploy gagal menemukan berkasnya.
  "name": "sendDailyApprovalReminder",
  "entry": "entry.ts",
  "automations": [
    {
      "name": "WA Pengingat Harian Approval 17:30",
      "description": "Setiap hari jam 17:30, kirim pengingat ke Owner tentang jumlah checklist menunggu approval",
      "function_args": null,
      "is_active": false,
      "type": "scheduled",
      "schedule_mode": "recurring",
      "schedule_type": "simple",
      "repeat_unit": "days",
      "repeat_interval": 1,
      "start_time": "17:30",
      "repeat_on_days": null,
      "repeat_on_day_of_month": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  ]
}