{
  "name": "TreatmentSchedule",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Nama treatment"
    },
    "mod_type": {
      "type": "string",
      "enum": [
        "obat",
        "vitamin",
        "checkup",
        "kebersihan",
        "perawatan_luka",
        "mandi",
        "jemur",
        "lainnya"
      ],
      "default": "lainnya",
      "description": "Jenis mod treatment"
    },
    "frequency": {
      "type": "string",
      "enum": [
        "harian",
        "2harian",
        "mingguan",
        "2mingguan",
        "bulanan",
        "quarterly",
        "musiman",
        "tahunan"
      ],
      "default": "mingguan",
      "description": "Frekuensi: harian=setiap hari, 2harian=setiap 2 hari, mingguan=1x/minggu, 2mingguan=tiap 2 minggu, bulanan=1x/bulan, quarterly=tiap 3 bulan, musiman=saat musim bertelur"
    },
    "weekly_days": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Hari dalam seminggu (0=Minggu)"
    },
    "monthly_dates": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Tanggal dalam bulan (1-31)"
    },
    "gender_filter": {
      "type": "string",
      "enum": [
        "semua",
        "jantan",
        "betina"
      ],
      "default": "semua"
    },
    "age_filter": {
      "type": "string",
      "enum": [
        "semua",
        "baby",
        "dewasa"
      ],
      "default": "semua",
      "description": "Filter umur kura-kura"
    },
    "tortoise_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tortoise_names": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "apply_to_all": {
      "type": "boolean",
      "default": false
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "dosage": {
      "type": "string",
      "description": "Dosis treatment (cth: 50mg/kg, 1 tablet/ekor)"
    },
    "item_sku": {
      "type": "string",
      "description": "SKU item terkait dari WarehouseItem"
    },
    "item_name": {
      "type": "string",
      "description": "Nama item terkait"
    },
    "sop_task_title": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "frequency"
  ]
}