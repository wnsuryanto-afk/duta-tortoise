{
  "name": "TreatmentSchedule",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Nama treatment"
    },
    "mod_type": {
      "type": "string",
      "enum": [
        "obat",
        "vitamin",
        "perawatan_luka",
        "mandi",
        "lainnya"
      ],
      "default": "lainnya",
      "description": "Jenis mod treatment"
    },
    "frequency": {
      "type": "string",
      "enum": [
        "harian",
        "mingguan",
        "bulanan",
        "tahunan"
      ],
      "default": "mingguan"
    },
    "weekly_days": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Hari dalam seminggu (0=Minggu)"
    },
    "monthly_dates": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Tanggal dalam bulan (1-31)"
    },
    "gender_filter": {
      "type": "string",
      "enum": [
        "semua",
        "jantan",
        "betina"
      ],
      "default": "semua"
    },
    "tortoise_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tortoise_names": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "apply_to_all": {
      "type": "boolean",
      "default": false
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "notes": {
      "type": "string"
    },
    "sop_task_title": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "frequency"
  ]
}