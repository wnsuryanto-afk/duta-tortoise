{
  "name": "TreatmentSchedule",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Nama treatment"
    },
    "mod_type": {
      "type": "string",
      "enum": [
        "obat",
        "vitamin",
        "perawatan_luka",
        "mandi",
        "checkup",
        "kebersihan",
        "lainnya"
      ],
      "default": "lainnya",
      "description": "Jenis mod treatment"
    },
    "frequency": {
      "type": "string",
      "enum": [
        "harian",
        "dua_harian",
        "mingguan",
        "dua_mingguan",
        "bulanan",
        "quarterly",
        "tahunan",
        "musiman"
      ],
      "default": "mingguan"
    },
    "frequency_interval_days": {
      "type": "number",
      "description": "Interval hari untuk perhitungan jadwal (dua_harian=2, dua_mingguan=14, quarterly=90)"
    },
    "weekly_days": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Hari dalam seminggu (0=Minggu)"
    },
    "monthly_dates": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Tanggal dalam bulan (1-31)"
    },
    "gender_filter": {
      "type": "string",
      "enum": [
        "semua",
        "jantan",
        "betina"
      ],
      "default": "semua"
    },
    "age_filter": {
      "type": "string",
      "enum": [
        "semua",
        "baby",
        "dewasa"
      ],
      "default": "semua",
      "description": "Filter kategori umur"
    },
    "tortoise_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tortoise_names": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "apply_to_all": {
      "type": "boolean",
      "default": false
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "dose": {
      "type": "string",
      "description": "Dosis / instruksi (cth: 50mg/kg berat badan)"
    },
    "related_sku": {
      "type": "string",
      "description": "SKU item stok gudang terkait (opsional)"
    },
    "sop_task_title": {
      "type": "string",
      "description": "Judul SOP task yang dibuat otomatis"
    },
    "deadline_time": {
      "type": "string",
      "description": "Waktu pelaksanaan ideal (HH:mm)"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "frequency"
  ]
}