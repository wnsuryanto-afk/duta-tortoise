{
  "name": "TreatmentSchedule",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Nama treatment (cth: Mandi, Timbang, Obat Cacing)"
    },
    "frequency": {
      "type": "string",
      "enum": [
        "harian",
        "mingguan",
        "bulanan",
        "tahunan"
      ],
      "default": "mingguan",
      "description": "Frekuensi treatment"
    },
    "weekly_days": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Hari dalam seminggu untuk mingguan (0=Minggu,1=Senin,...6=Sabtu)"
    },
    "monthly_dates": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Tanggal-tanggal dalam bulan untuk bulanan (1-31)"
    },
    "gender_filter": {
      "type": "string",
      "enum": [
        "semua",
        "jantan",
        "betina"
      ],
      "default": "semua",
      "description": "Filter berdasarkan jenis kelamin"
    },
    "tortoise_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "ID kura-kura yang dijadwalkan (kosong = semua)"
    },
    "tortoise_names": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Nama kura-kura"
    },
    "apply_to_all": {
      "type": "boolean",
      "default": false,
      "description": "Berlaku untuk semua kura-kura"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "notes": {
      "type": "string"
    },
    "sop_task_title": {
      "type": "string",
      "description": "Judul SOP task yang terhubung (auto-insert)"
    }
  },
  "required": [
    "title",
    "frequency"
  ]
}