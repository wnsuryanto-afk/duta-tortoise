{
  "name": "SaleChannel",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nama channel (contoh: Instagram, Tokopedia)"
    },
    "type": {
      "type": "string",
      "enum": [
        "marketplace",
        "sosmed",
        "langsung",
        "referral"
      ]
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name"
  ]
}