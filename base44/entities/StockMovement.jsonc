{
  "name": "StockMovement",
  "type": "object",
  "properties": {
    "item_id": {
      "type": "string",
      "description": "ID item (FeedStock atau WarehouseItem)"
    },
    "item_type": {
      "type": "string",
      "enum": [
        "feedstock",
        "warehouse"
      ],
      "description": "Jenis entitas"
    },
    "item_name": {
      "type": "string",
      "description": "Nama item"
    },
    "item_sku": {
      "type": "string",
      "description": "SKU item"
    },
    "type": {
      "type": "string",
      "enum": [
        "masuk",
        "keluar"
      ],
      "description": "Jenis pergerakan stok"
    },
    "quantity": {
      "type": "number",
      "description": "Jumlah"
    },
    "unit": {
      "type": "string"
    },
    "unit_price": {
      "type": "number",
      "default": 0
    },
    "total_value": {
      "type": "number",
      "default": 0,
      "description": "Nilai total (qty x harga)"
    },
    "total_purchase_price": {
      "type": "number",
      "default": 0,
      "description": "Harga beli total (untuk barang masuk)"
    },
    "stock_after": {
      "type": "number",
      "description": "Sisa stok setelah transaksi ini"
    },
    "keperluan": {
      "type": "string",
      "enum": [
        "pemberian_pakan",
        "pengobatan_kura",
        "kebersihan",
        "perbaikan",
        "lainnya"
      ],
      "description": "Keperluan pengambilan (untuk barang keluar)"
    },
    "supplier": {
      "type": "string",
      "description": "Sumber/supplier barang (untuk barang masuk)"
    },
    "enclosure_name": {
      "type": "string",
      "description": "Kandang tujuan (opsional, untuk barang keluar)"
    },
    "tortoise_code": {
      "type": "string",
      "description": "Kode kura tujuan (opsional, untuk barang keluar)"
    },
    "by_email": {
      "type": "string",
      "description": "Email user yang melakukan"
    },
    "by_name": {
      "type": "string",
      "description": "Nama user yang melakukan"
    },
    "notes": {
      "type": "string",
      "description": "Keterangan"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "selesai",
        "menunggu_approval",
        "disetujui",
        "ditolak"
      ],
      "default": "selesai",
      "description": "Status transaksi"
    },
    "approved_by": {
      "type": "string"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "rejected_reason": {
      "type": "string"
    },
    "photo_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Foto nota/bukti transaksi"
    },
    "migrated_from_item_usage": {
      "type": "boolean",
      "default": false,
      "description": "Data dimigrasikan dari ItemUsage lama"
    },
    "excluded_from_reports": {
      "type": "boolean",
      "default": false,
      "description": "Dikecualikan dari laporan (owner only)"
    },
    "is_test_data": {
      "type": "boolean",
      "default": false,
      "description": "Ditandai sebagai data test \u2014 tidak masuk laporan"
    }
  },
  "required": [
    "item_id",
    "item_name",
    "quantity",
    "type",
    "by_email",
    "date"
  ]
}