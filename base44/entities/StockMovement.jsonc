{
  "name": "StockMovement",
  "properties": {
    "approved_at": {
      "format": "date-time",
      "type": "string"
    },
    "approved_by": {
      "type": "string"
    },
    "batch_id": {
      "description": "BatchBarang yang ikut berkurang saat pengambilan lewat Ambil Barang. Diisi supaya pembatalan bisa mengembalikan sisa batch, bukan hanya stok barangnya. Tanpa kolom ini, membatalkan satu pengambilan mengembalikan stok gudang tapi meninggalkan batch tetap berkurang - dua angka untuk satu barang yang sama.",
      "type": "string"
    },
    "by_email": {
      "description": "Email user yang melakukan",
      "type": "string"
    },
    "by_name": {
      "description": "Nama user yang melakukan",
      "type": "string"
    },
    "date": {
      "format": "date",
      "type": "string"
    },
    "enclosure_name": {
      "description": "Kandang tujuan (opsional, untuk barang keluar)",
      "type": "string"
    },
    "excluded_from_reports": {
      "default": false,
      "description": "Dikecualikan dari laporan (owner only)",
      "type": "boolean"
    },
    "feed_source": {
      "description": "Sumber pakan masuk (untuk feedstock masuk)",
      "enum": [
        "beli_pasar",
        "kebun_sendiri",
        "panen_azola",
        "kiriman_supplier",
        "lainnya"
      ],
      "type": "string"
    },
    "is_test_data": {
      "default": false,
      "description": "Ditandai sebagai data test \u2014 tidak masuk laporan",
      "type": "boolean"
    },
    "item_id": {
      "description": "ID item (FeedStock atau WarehouseItem)",
      "type": "string"
    },
    "item_name": {
      "description": "Nama item",
      "type": "string"
    },
    "item_sku": {
      "description": "SKU item",
      "type": "string"
    },
    "item_type": {
      "description": "Jenis entitas",
      "enum": [
        "feedstock",
        "warehouse"
      ],
      "type": "string"
    },
    "keperluan": {
      "description": "Keperluan pengambilan (untuk barang keluar)",
      "enum": [
        "pemberian_pakan",
        "pakan_pagi",
        "pakan_siang",
        "pakan_iguana",
        "pakan_baby",
        "pengobatan_kura",
        "kebersihan",
        "perbaikan",
        "dibuang_kedaluwarsa",
        "lainnya"
      ],
      "type": "string"
    },
    "linked_pakan_harian_id": {
      "description": "ID PakanHarian jika transaksi ini auto-generated dari pencatatan pakan harian (anti-dobel)",
      "type": "string"
    },
    "migrated_from_item_usage": {
      "default": false,
      "description": "Data dimigrasikan dari ItemUsage lama",
      "type": "boolean"
    },
    "notes": {
      "description": "Keterangan",
      "type": "string"
    },
    "photo_urls": {
      "description": "Foto nota/bukti transaksi",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "quantity": {
      "description": "Jumlah",
      "type": "number"
    },
    "rejected_reason": {
      "type": "string"
    },
    "status": {
      "default": "selesai",
      "description": "Status transaksi",
      "enum": [
        "selesai",
        "menunggu_approval",
        "disetujui",
        "ditolak"
      ],
      "type": "string"
    },
    "stock_after": {
      "description": "Sisa stok setelah transaksi ini",
      "type": "number"
    },
    "supplier": {
      "description": "Sumber/supplier barang (untuk barang masuk). Teks bebas \u2014 tetap dipakai untuk sumber yang bukan supplier terdaftar (beli pasar, kebun sendiri). Bila supplier_id terisi, kolom ini diisi namanya supaya catatan lama tetap terbaca sama.",
      "type": "string"
    },
    "supplier_id": {
      "description": "Supplier terdaftar yang mengirim barang ini. Ditambahkan 18 Okt 2026: sebelum ini supplier hanya teks bebas, jadi tidak ada satu pun barang masuk yang menunjuk balik ke entitas Supplier \u2014 dan tanpa itu peringkat keandalan supplier tidak bisa dihitung dari kenyataan, hanya dari bintang yang diketik sendiri. Kosong untuk sumber yang memang bukan supplier terdaftar.",
      "type": "string"
    },
    "tortoise_code": {
      "description": "Kode kura tujuan (opsional, untuk barang keluar)",
      "type": "string"
    },
    "total_purchase_price": {
      "default": 0,
      "description": "Harga beli total (untuk barang masuk)",
      "type": "number"
    },
    "total_value": {
      "default": 0,
      "description": "Nilai total (qty x harga)",
      "type": "number"
    },
    "type": {
      "description": "Jenis pergerakan stok",
      "enum": [
        "masuk",
        "keluar"
      ],
      "type": "string"
    },
    "unit": {
      "type": "string"
    },
    "unit_price": {
      "default": 0,
      "type": "number"
    }
  },
  "required": [
    "item_id",
    "item_name",
    "quantity",
    "type",
    "by_email",
    "date"
  ],
  "type": "object"
}