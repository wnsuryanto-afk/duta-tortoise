{
  "name": "PakanHarian",
  "properties": {
    "basket_count": {
      "description": "Jumlah keranjang yang diambil/diberikan. Dipakai untuk pakan yang memang dihitung per keranjang. Untuk pakan yang DITIMBANG, isi weight_kg \u2014 bukan kolom ini. Tiga catatan pertama (Jul\u2013Sep 2026) sempat memakai kolom ini untuk kilogram (Mentimun 64,97), jadi angka lama di sini tidak selalu berarti keranjang.",
      "type": "number"
    },
    "excluded_from_reports": {
      "description": "Dikecualikan dari laporan",
      "type": "boolean"
    },
    "feed_source": {
      "default": "rumput",
      "description": "Sumber pakan",
      "enum": [
        "rumput",
        "sayur_pasar",
        "campur",
        "lainnya"
      ],
      "type": "string"
    },
    "feed_type_detail": {
      "description": "Detail jenis pakan (contoh: kangkung, sawi, rumput gajah)",
      "type": "string"
    },
    "is_test_data": {
      "description": "Data uji, tidak ikut laporan",
      "type": "boolean"
    },
    "log_date": {
      "description": "Tanggal pencatatan",
      "format": "date",
      "type": "string"
    },
    "notes": {
      "description": "Catatan tambahan",
      "type": "string"
    },
    "photo_url": {
      "description": "Foto bukti \u2014 diarahkan ke layar timbangan supaya angkanya bisa diperiksa ulang, bukan foto pakannya saja.",
      "type": "string"
    },
    "recorded_by_email": {
      "type": "string"
    },
    "recorded_by_name": {
      "description": "Nama keeper/kepala feeder yang mencatat",
      "type": "string"
    },
    "session": {
      "default": "pagi",
      "description": "Sesi pemberian pakan",
      "enum": [
        "pagi",
        "sore"
      ],
      "type": "string"
    },
    "sop_task_id": {
      "description": "SOPTask yang dicentang saat catatan ini dibuat. Diisi otomatis bila pencatatan datang dari layar Tugas Hari Ini, kosong bila dicatat lepas dari tugas.",
      "type": "string"
    },
    "trip_cost_rokok": {
      "description": "Biaya rokok tukar keranjang (Rp), hanya jika sayur pasar",
      "type": "number"
    },
    "trip_cost_solar": {
      "description": "Biaya solar (Rp), hanya jika ambil sayur pasar",
      "type": "number"
    },
    "trip_finance_tx_id": {
      "description": "ID FinanceTransaction biaya trip (jika dibuat)",
      "type": "string"
    },
    "weight_kg": {
      "description": "Berat timbangan dalam kilogram. Ini satuan yang sebenarnya dipakai di lapangan untuk sebagian besar pakan; sebelum kolom ini ada, beratnya terpaksa dituliskan ke basket_count sehingga 64,97 kg tercatat sebagai 64,97 keranjang.",
      "type": "number"
    }
  },
  "required": [
    "log_date",
    "session",
    "recorded_by_name"
  ],
  "type": "object"
}