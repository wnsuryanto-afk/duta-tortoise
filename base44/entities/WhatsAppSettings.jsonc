{
  "name": "WhatsAppSettings",
  "type": "object",
  "properties": {
    "setting_key": {
      "type": "string",
      "default": "main",
      "description": "Key unik (selalu 'main') untuk single-record pattern"
    },
    "fonnte_token": {
      "type": "string",
      "description": "Token API Fonnte \u2014 dibaca server-side oleh backend function"
    },
    "phone_owner": {
      "type": "string",
      "description": "Nomor WhatsApp Owner (format 08xxx atau 62xxx)"
    },
    "phone_manajer": {
      "type": "string",
      "description": "Nomor WhatsApp Manajer"
    },
    "phone_admin": {
      "type": "string",
      "description": "Nomor WhatsApp Admin"
    },
    "employee_phones": {
      "type": "array",
      "description": "Daftar nomor WhatsApp per karyawan",
      "items": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          }
        }
      }
    },
    "notif_daily_approval": {
      "type": "boolean",
      "default": true,
      "description": "Pengingat harian checklist menunggu approval (17:30)"
    },
    "notif_sick_report": {
      "type": "boolean",
      "default": true,
      "description": "Laporan kura sakit baru \u2192 Owner + Manajer"
    },
    "notif_low_stock": {
      "type": "boolean",
      "default": true,
      "description": "Stok obat/suplemen menyentuh minimum \u2192 Owner + Manajer + Admin"
    },
    "notif_salary_paid": {
      "type": "boolean",
      "default": false,
      "description": "Gaji ditandai dibayar \u2192 karyawan ybs"
    },
    "notif_incidental_task": {
      "type": "boolean",
      "default": false,
      "description": "Tugas insidentil baru \u2192 karyawan yang ditugaskan"
    },
    "notif_tool_request": {
      "type": "boolean",
      "default": false,
      "description": "Laporan alat rusak / pengajuan barang \u2192 Owner + Manajer"
    },
    "daily_reminder_last_sent": {
      "type": "string",
      "format": "date",
      "description": "Tanggal terakhir pengingat harian dikirim (anti dobel)"
    },
    "group_id": {
      "type": "string",
      "description": "ID Grup WhatsApp untuk kirim ringkasan harian (format: 120363xxx@g.us)"
    },
    "summary_destination": {
      "type": "string",
      "enum": [
        "individuals",
        "group",
        "both"
      ],
      "default": "individuals",
      "description": "Tujuan pengiriman ringkasan: individuals = nomor perorangan, group = grup WhatsApp, both = keduanya"
    },
    "summary_recipients": {
      "type": "array",
      "description": "Daftar penerima ringkasan (nomor perorangan) \u2014 dipilih owner via checkbox",
      "items": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          }
        }
      }
    },
    "daily_summary_time": {
      "type": "string",
      "default": "17:00",
      "description": "Jam kirim ringkasan sore (HH:mm, UTC)"
    },
    "daily_summary_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Aktifkan kirim ringkasan sore ke tujuan terpilih"
    },
    "daily_summary_show_points": {
      "type": "boolean",
      "default": false,
      "description": "Tampilkan poin per orang di ringkasan. Default nonaktif \u2014 hindari perbandingan poin antar karyawan."
    },
    "summary_schedule_pattern": {
      "type": "string",
      "enum": [
        "daily",
        "every_2_days",
        "every_3_days",
        "weekdays",
        "specific_days",
        "weekly"
      ],
      "default": "daily",
      "description": "Pola jadwal kirim ringkasan: daily, every_2_days, every_3_days, weekdays (Sen-Sab), specific_days (hari terpilih), weekly (Sabtu)"
    },
    "summary_selected_days": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Hari terpilih untuk pola specific_days (0=Min, 1=Sen, ..., 6=Sab)"
    },
    "daily_summary_last_sent": {
      "type": "string",
      "format": "date",
      "description": "Tanggal terakhir ringkasan sore terkirim (anti dobel)"
    },
    "summary_retry_count": {
      "type": "number",
      "default": 0,
      "description": "Jumlah retry untuk siklus pengiriman sore saat ini"
    },
    "summary_last_attempt": {
      "type": "string",
      "format": "date-time",
      "description": "Waktu percobaan kirim sore terakhir (untuk retry spacing)"
    },
    "morning_summary_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Aktifkan ringkasan pagi (rencana hari)"
    },
    "morning_summary_time": {
      "type": "string",
      "default": "07:00",
      "description": "Jam kirim ringkasan pagi (HH:mm, UTC)"
    },
    "morning_summary_last_sent": {
      "type": "string",
      "format": "date",
      "description": "Tanggal terakhir ringkasan pagi terkirim (anti dobel)"
    },
    "morning_retry_count": {
      "type": "number",
      "default": 0,
      "description": "Jumlah retry untuk siklus pengiriman pagi saat ini"
    },
    "morning_last_attempt": {
      "type": "string",
      "format": "date-time",
      "description": "Waktu percobaan kirim pagi terakhir (untuk retry spacing)"
    },
    "weekly_summary_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Kirim ringkasan mingguan setiap Sabtu pada jam yang sama"
    },
    "weekly_summary_last_sent": {
      "type": "string",
      "format": "date",
      "description": "Tanggal terakhir ringkasan mingguan terkirim (anti dobel)"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_by": {
      "type": "string",
      "description": "Email user terakhir edit"
    }
  },
  "required": [
    "setting_key"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "owner"
      }
    },
    "create": {
      "user_condition": {
        "role": "owner"
      }
    },
    "update": {
      "user_condition": {
        "role": "owner"
      }
    },
    "delete": {
      "user_condition": {
        "role": "owner"
      }
    }
  }
}