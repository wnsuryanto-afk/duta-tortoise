{
  "name": "WhatsAppSettings",
  "properties": {
    "ai_calls_count_date": {
      "description": "Tanggal terakhir counter ai_calls_today direset",
      "format": "date",
      "type": "string"
    },
    "ai_calls_today": {
      "default": 0,
      "description": "Jumlah panggilan AI hari ini (reset harian untuk pantau biaya)",
      "type": "number"
    },
    "ai_smart_alerts_enabled": {
      "default": false,
      "description": "Peringatan cerdas — saring notifikasi seketika dengan AI. Bila nonaktif, semua notifikasi dikirim seperti biasa.",
      "type": "boolean"
    },
    "ai_sorotan_enabled": {
      "default": true,
      "description": "Sorotan AI di bagian atas ringkasan harian (3-4 kalimat). Bila AI gagal, ringkasan tetap terkirim tanpa sorotan.",
      "type": "boolean"
    },
    "ai_weekly_enabled": {
      "default": true,
      "description": "Laporan mingguan analitis AI (analisis + 3 saran). Bila AI gagal, fallback ke template biasa.",
      "type": "boolean"
    },
    "daily_reminder_last_sent": {
      "description": "Tanggal & jam WIB terakhir pengingat harian dikirim (anti dobel). Format: 'YYYY-MM-DD HH:mm WIB'. Anti-dobel membandingkan 10 karakter pertama (tanggal) dengan tanggal WIB hari ini.",
      "type": "string"
    },
    "daily_summary_enabled": {
      "default": false,
      "description": "Aktifkan kirim ringkasan sore ke tujuan terpilih",
      "type": "boolean"
    },
    "daily_summary_last_sent": {
      "description": "Tanggal & jam WIB terakhir ringkasan sore terkirim (anti dobel). Format: 'YYYY-MM-DD HH:mm WIB'. Anti-dobel membandingkan 10 karakter pertama (tanggal) dengan tanggal WIB hari ini.",
      "type": "string"
    },
    "daily_summary_show_points": {
      "default": false,
      "description": "Tampilkan poin per orang di ringkasan SORE. Aman aktif karena grup sore tidak berisi keeper.",
      "type": "boolean"
    },
    "daily_approval_time": {
      "default": "17:30",
      "description": "Jam kirim pengingat approval dalam WIB (Asia/Jakarta, UTC+7). Contoh: 17:30 = jam setengah 6 sore WIB. Backend membandingkan jam WIB sekarang dengan jam ini — penjadwal boleh memanggil kapan saja.",
      "type": "string"
    },
    "daily_summary_time": {
      "default": "16:30",
      "description": "Jam kirim ringkasan sore dalam WIB (Asia/Jakarta, UTC+7). Contoh: 16:30 = jam 4 sore WIB. Backend membandingkan jam WIB sekarang dengan jam ini — tidak ada konversi UTC.",
      "type": "string"
    },
    "employee_phones": {
      "description": "Daftar nomor WhatsApp per karyawan",
      "items": {
        "properties": {
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "fonnte_token": {
      "description": "Token API Fonnte — dibaca server-side oleh backend function",
      "type": "string"
    },
    "group_id": {
      "description": "ID Grup WhatsApp SORE (manajemen, tanpa keeper) untuk ringkasan hasil (format: 120363xxx@g.us)",
      "type": "string"
    },
    "morning_group_id": {
      "description": "ID Grup WhatsApp PAGI (berisi keeper) untuk perintah kerja harian (format: 120363xxx@g.us)",
      "type": "string"
    },
    "morning_summary_destination": {
      "default": "group",
      "description": "Tujuan ringkasan pagi",
      "enum": [
        "individuals",
        "group",
        "both"
      ],
      "type": "string"
    },
    "morning_summary_enabled": {
      "default": false,
      "description": "Aktifkan ringkasan PAGI (perintah kerja) ke grup pagi. Butuh morning_group_id terisi lebih dulu.",
      "type": "boolean"
    },
    "morning_summary_last_sent": {
      "description": "Tanggal & jam WIB terakhir ringkasan pagi terkirim (anti dobel). Format: 'YYYY-MM-DD HH:mm WIB'. Anti-dobel membandingkan 10 karakter pertama (tanggal) dengan tanggal WIB hari ini.",
      "type": "string"
    },
    "morning_summary_show_points": {
      "default": false,
      "description": "JANGAN aktifkan — grup pagi berisi keeper, menampilkan poin memicu perbandingan antar karyawan",
      "type": "boolean"
    },
    "morning_summary_time": {
      "default": "07:00",
      "description": "Jam kirim ringkasan pagi dalam WIB (Asia/Jakarta, UTC+7). Contoh: 07:00 = jam 7 pagi WIB. Backend membandingkan jam WIB sekarang dengan jam ini — tidak ada konversi UTC.",
      "type": "string"
    },
    "notif_daily_approval": {
      "default": true,
      "description": "Pengingat harian checklist menunggu approval. Jamnya diatur di daily_approval_time.",
      "type": "boolean"
    },
    "notif_incidental_task": {
      "default": false,
      "description": "Tugas insidentil baru → karyawan yang ditugaskan",
      "type": "boolean"
    },
    "notif_low_stock": {
      "default": true,
      "description": "Stok obat/suplemen menyentuh minimum → Owner + Manajer + Admin",
      "type": "boolean"
    },
    "notif_low_stock_destination": {
      "type": "string",
      "enum": [
        "individuals",
        "group",
        "both"
      ],
      "default": "individuals",
      "description": "Tujuan notifikasi stok menipis."
    },
    "notif_low_stock_group_id": {
      "type": "string",
      "description": "ID grup tujuan notifikasi stok menipis. Kosong = pakai Grup SORE."
    },
    "notif_salary_paid": {
      "default": false,
      "description": "Gaji ditandai dibayar → karyawan ybs",
      "type": "boolean"
    },
    "notif_sick_report": {
      "default": true,
      "description": "Laporan kura sakit baru → Owner + Manajer",
      "type": "boolean"
    },
    "notif_sick_report_destination": {
      "type": "string",
      "enum": [
        "individuals",
        "group",
        "both"
      ],
      "default": "individuals",
      "description": "Tujuan notifikasi laporan kura sakit."
    },
    "notif_sick_report_group_id": {
      "type": "string",
      "description": "ID grup tujuan notifikasi kura sakit. Kosong = pakai Grup PAGI."
    },
    "notif_tool_request": {
      "default": false,
      "description": "Laporan alat rusak / pengajuan barang → Owner + Manajer",
      "type": "boolean"
    },
    "notif_tool_request_destination": {
      "type": "string",
      "enum": [
        "individuals",
        "group",
        "both"
      ],
      "default": "individuals",
      "description": "Tujuan notifikasi alat rusak / pengajuan barang."
    },
    "notif_tool_request_group_id": {
      "type": "string",
      "description": "ID grup tujuan notifikasi alat rusak. Kosong = pakai Grup PAGI."
    },
    "phone_admin": {
      "description": "Nomor WhatsApp Admin",
      "type": "string"
    },
    "phone_manajer": {
      "description": "Nomor WhatsApp Manajer",
      "type": "string"
    },
    "phone_owner": {
      "description": "Nomor WhatsApp Owner (format 08xxx atau 62xxx)",
      "type": "string"
    },
    "pic_administrasi": {
      "type": "string",
      "description": "Email PJ administrasi & kelengkapan data di ringkasan PR. Kosong = semua role admin."
    },
    "pic_approval": {
      "type": "string",
      "description": "Email PJ approval poin & pengawasan tim di ringkasan PR. Kosong = semua role manajer."
    },
    "pic_pembelian": {
      "type": "string",
      "description": "Email PJ pembelian & talangan di ringkasan PR. Kosong = semua role owner."
    },
    "setting_key": {
      "default": "main",
      "description": "Key unik (selalu 'main') untuk single-record pattern",
      "type": "string"
    },
    "summary_destination": {
      "default": "individuals",
      "description": "Tujuan pengiriman ringkasan sore: individuals = nomor perorangan, group = grup WhatsApp, both = keduanya",
      "enum": [
        "individuals",
        "group",
        "both"
      ],
      "type": "string"
    },
    "summary_recipients": {
      "description": "Daftar penerima ringkasan (nomor perorangan) — dipilih owner via checkbox",
      "items": {
        "properties": {
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "summary_show_pr": {
      "type": "boolean",
      "default": true,
      "description": "Tampilkan bagian 'PR MASING-MASING' di ringkasan SORE."
    },
    "updated_at": {
      "format": "date-time",
      "type": "string"
    },
    "updated_by": {
      "description": "Email user terakhir edit",
      "type": "string"
    },
    "wa_groups": {
      "type": "array",
      "description": "Grup WhatsApp tambahan di luar Grup PAGI dan Grup SORE.",
      "items": {
        "type": "object",
        "properties": {
          "group_id": {
            "type": "string",
            "description": "ID grup, format 120363xxxxxxxxx@g.us"
          },
          "name": {
            "type": "string",
            "description": "Nama grup agar mudah dikenali"
          },
          "note": {
            "type": "string",
            "description": "Catatan singkat"
          }
        }
      }
    },
    "weekly_summary_enabled": {
      "default": false,
      "description": "Kirim ringkasan mingguan setiap Sabtu pada jam yang sama",
      "type": "boolean"
    },
    "weekly_summary_last_sent": {
      "description": "Tanggal & jam WIB terakhir ringkasan mingguan terkirim (anti dobel). Format: 'YYYY-MM-DD HH:mm WIB'. Anti-dobel membandingkan 10 karakter pertama (tanggal) dengan tanggal WIB hari ini.",
      "type": "string"
    }
  },
  "required": [
    "setting_key"
  ],
  "type": "object",
  "rls": {
    "read": {
      "user_condition": {
        "role": "owner"
      }
    },
    "create": {
      "user_condition": {
        "role": "owner"
      }
    },
    "update": {
      "user_condition": {
        "role": "owner"
      }
    },
    "delete": {
      "user_condition": {
        "role": "owner"
      }
    }
  }
}