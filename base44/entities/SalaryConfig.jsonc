{
  "name": "SalaryConfig",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "keeper",
        "admin",
        "manajer"
      ]
    },
    "base_salary": {
      "type": "number",
      "default": 0
    },
    "overtime_rate_per_hour": {
      "type": "number",
      "default": 0
    },
    "vegetable_rate_per_trip": {
      "type": "number",
      "default": 0
    },
    "point_value": {
      "type": "number",
      "default": 0
    },
    "absent_deduction": {
      "type": "number",
      "default": 0
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "role",
    "base_salary"
  ]
}