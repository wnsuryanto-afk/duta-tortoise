{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "hp_whatsapp": {
      "type": "string",
      "description": "No. HP / WhatsApp"
    },
    "address": {
      "type": "string"
    },
    "photo_url": {
      "type": "string"
    },
    "id_number": {
      "type": "string"
    },
    "join_date": {
      "type": "string",
      "format": "date"
    },
    "emergency_contact": {
      "type": "string"
    },
    "bank_name": {
      "type": "string"
    },
    "bank_account_number": {
      "type": "string"
    },
    "bank_account_name": {
      "type": "string"
    },
    "is_complete": {
      "type": "boolean",
      "default": false,
      "description": "true jika full_name, hp_whatsapp, join_date, bank_name, dan bank_account_number semua terisi"
    },
    "tour_completed": {
      "type": "boolean",
      "default": false
    },
    "tour_skipped": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "user_id",
    "user_email",
    "full_name",
    "hp_whatsapp",
    "join_date"
  ]
}