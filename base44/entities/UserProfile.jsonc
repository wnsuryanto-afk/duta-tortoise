  "properties": {
    "user_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "photo_url": {
      "type": "string"
    },
    "id_number": {
      "type": "string"
    },
    "join_date": {
      "type": "string",
      "format": "date"
    },
    "emergency_contact": {
      "type": "string"
    },
    "bank_name": {
      "type": "string"
    },
    "bank_account_number": {
      "type": "string"
    },
    "bank_account_name": {
      "type": "string"
    },
    "is_complete": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
