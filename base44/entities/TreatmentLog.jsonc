{
  "name": "TreatmentLog",
  "type": "object",
  "properties": {
    "treat_log_key": {
      "type": "string",
      "description": "Unique key: tortoise_id__treat_id__date (untuk daily checklist)"
    },
    "schedule_id": {
      "type": "string"
    },
    "schedule_title": {
      "type": "string"
    },
    "tortoise_id": {
      "type": "string"
    },
    "tortoise_name": {
      "type": "string"
    },
    "done_date": {
      "type": "string",
      "format": "date"
    },
    "done_by": {
      "type": "string"
    },
    "is_done": {
      "type": "boolean",
      "default": true,
      "description": "Status selesai (bisa di-uncheck)"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "schedule_title",
    "tortoise_name",
    "done_date",
    "done_by"
  ]
}