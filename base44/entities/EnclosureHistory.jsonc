{
  "name": "EnclosureHistory",
  "type": "object",
  "properties": {
    "tortoise_id": {
      "type": "string",
      "description": "ID kura-kura"
    },
    "tortoise_name": {
      "type": "string",
      "description": "Nama kura-kura"
    },
    "from_enclosure": {
      "type": "string",
      "description": "Kandang asal"
    },
    "to_enclosure": {
      "type": "string",
      "description": "Kandang tujuan"
    },
    "moved_date": {
      "type": "string",
      "format": "date",
      "description": "Tanggal perpindahan"
    },
    "reason": {
      "type": "string",
      "description": "Alasan perpindahan"
    },
    "moved_by": {
      "type": "string",
      "description": "Nama/email yang memindahkan"
    }
  },
  "required": [
    "tortoise_id",
    "tortoise_name",
    "to_enclosure",
    "moved_date"
  ]
}