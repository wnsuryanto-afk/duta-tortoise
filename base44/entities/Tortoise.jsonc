{
  "name": "Tortoise",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nama tortoise"
    },
    "code": {
      "type": "string",
      "description": "Kode identifikasi unik"
    },
    "gender": {
      "type": "string",
      "enum": [
        "jantan",
        "betina",
        "belum_diketahui"
      ],
      "default": "belum_diketahui"
    },
    "morph": {
      "type": "string",
      "enum": [
        "normal",
        "albino",
        "ivory",
        "caramel_albino",
        "hypo",
        "golden_greek",
        "piebald",
        "genetic_stripe",
        "high_yellow",
        "dark",
        "paradox",
        "anerythristic",
        "axanthic",
        "melanistic",
        "mix",
        "unknown"
      ],
      "default": "normal"
    },
    "shell_type": {
      "type": "string",
      "enum": [
        "normal",
        "less_scute",
        "over_scute",
        "pyramiding",
        "smooth",
        "wavy",
        "irregular"
      ],
      "default": "normal"
    },
    "source": {
      "type": "string",
      "enum": [
        "hasil_sendiri",
        "beli_lokal",
        "import",
        "tidak_diketahui"
      ],
      "default": "tidak_diketahui"
    },
    "is_proven": {
      "type": "boolean",
      "default": false
    },
    "birth_date": {
      "type": "string",
      "format": "date"
    },
    "purchase_date": {
      "type": "string",
      "format": "date"
    },
    "purchase_price": {
      "type": "number"
    },
    "microchip_id": {
      "type": "string"
    },
    "weight_grams": {
      "type": "number"
    },
    "shell_length_cm": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "aktif",
        "baby",
        "sakit",
        "breeding",
        "mati",
        "terjual",
        "diarsipkan"
      ],
      "default": "aktif"
    },
    "previous_status": {
      "type": "string",
      "description": "Status sebelumnya (disimpan saat berubah ke 'sakit' untuk restore nanti)"
    },
    "is_currently_sick": {
      "type": "boolean",
      "default": false,
      "description": "Flag visual badge SAKIT"
    },
    "last_status_change": {
      "type": "string",
      "format": "date",
      "description": "Tanggal terakhir status berubah"
    },
    "enclosure": {
      "type": "string"
    },
    "in_quarantine": {
      "type": "boolean",
      "default": false,
      "description": "Apakah sedang dikarantina"
    },
    "quarantine_start_date": {
      "type": "string",
      "format": "date",
      "description": "Tanggal mulai karantina"
    },
    "quarantine_reason": {
      "type": "string",
      "enum": [
        "pendatang_baru",
        "sakit",
        "cedera",
        "observasi",
        "sebelum_dijual",
        "lainnya"
      ],
      "description": "Alasan karantina"
    },
    "quarantine_notes": {
      "type": "string",
      "description": "Catatan karantina"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "weight_grams": {
            "type": "number"
          },
          "shell_length_cm": {
            "type": "number"
          },
          "notes": {
            "type": "string"
          }
        }
      },
      "description": "Foto pertumbuhan dengan data biometrik"
    },
    "death_video_url": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Preset tags: Indukan Premium, Akan Dijual, Perlu Treatment, Favorit Owner, Tidak Untuk Dijual, Pendatang Baru, Juara Kontes"
    },
    "qr_code_url": {
      "type": "string"
    },
    "sale_channel": {
      "type": "string",
      "enum": [
        "Instagram",
        "Tokopedia",
        "Shopee",
        "WhatsApp",
        "Facebook",
        "Referral",
        "Langsung",
        "Lainnya"
      ]
    },
    "notes": {
      "type": "string"
    },
    "parent_male": {
      "type": "string"
    },
    "parent_female": {
      "type": "string"
    },
    "is_archived": {
      "type": "boolean",
      "default": false,
      "description": "Apakah data sudah diarsipkan"
    }
  },
  "required": [
    "name",
    "gender",
    "morph",
    "source",
    "status"
  ]
}