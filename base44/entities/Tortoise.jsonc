{
  "name": "Tortoise",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nama tortoise"
    },
    "code": {
      "type": "string",
      "description": "Kode identifikasi unik"
    },
    "gender": {
      "type": "string",
      "enum": [
        "jantan",
        "betina",
        "belum_diketahui"
      ],
      "default": "belum_diketahui"
    },
    "species": {
      "type": "string",
      "enum": [
        "sulcata",
        "red_foot",
        "leopard",
        "aldabra",
        "russian",
        "hermann",
        "greek",
        "indian_star",
        "lainnya"
      ],
      "default": "sulcata",
      "description": "Spesies kura-kura"
    },
    "species_params": {
      "type": "object",
      "description": "Parameter ideal berdasarkan spesies (auto-fill)",
      "properties": {
        "basking_temp_min": {
          "type": "number"
        },
        "basking_temp_max": {
          "type": "number"
        },
        "ambient_temp_min": {
          "type": "number"
        },
        "ambient_temp_max": {
          "type": "number"
        },
        "humidity_min": {
          "type": "number"
        },
        "humidity_max": {
          "type": "number"
        },
        "adult_size_cm": {
          "type": "number"
        },
        "weighing_interval_adult_days": {
          "type": "number"
        }
      }
    },
    "morph": {
      "type": "string",
      "enum": [
        "normal",
        "het_albino",
        "het_caramel_albino",
        "het_hypo",
        "het_ivory",
        "double_het",
        "albino",
        "ivory",
        "caramel_albino",
        "hypo",
        "golden_greek",
        "piebald",
        "genetic_stripe",
        "high_yellow",
        "dark",
        "paradox",
        "anerythristic",
        "axanthic",
        "melanistic",
        "mix",
        "unknown"
      ],
      "default": "normal"
    },
    "shell_type": {
      "type": "string",
      "enum": [
        "normal",
        "less_scute",
        "over_scute",
        "pyramiding",
        "smooth",
        "wavy",
        "irregular"
      ],
      "default": "normal"
    },
    "source": {
      "type": "string",
      "enum": [
        "cb",
        "wc",
        "f1",
        "f2",
        "ltc",
        "hasil_sendiri",
        "beli_lokal",
        "import",
        "tidak_diketahui"
      ],
      "default": "tidak_diketahui"
    },
    "is_proven": {
      "type": "boolean",
      "default": false
    },
    "proven_year": {
      "type": "number"
    },
    "last_breeding_id": {
      "type": "string",
      "description": "ID Breeding terakhir"
    },
    "birth_date": {
      "type": "string",
      "format": "date"
    },
    "purchase_date": {
      "type": "string",
      "format": "date"
    },
    "purchase_price": {
      "type": "number"
    },
    "microchip_id": {
      "type": "string"
    },
    "weight_grams": {
      "type": "number"
    },
    "shell_length_cm": {
      "type": "number"
    },
    "age_category": {
      "type": "string",
      "enum": [
        "baby",
        "juvenile",
        "dewasa"
      ],
      "description": "Kategori umur: baby (0-12 bln), juvenile (1-3 thn), dewasa (>3 thn). Auto-calculated dari birth_date."
    },
    "last_weighed_date": {
      "type": "string",
      "format": "date",
      "description": "Tanggal terakhir ditimbang"
    },
    "weighing_interval_days": {
      "type": "number",
      "description": "Interval timbang: baby=14, juvenile=30, dewasa=90"
    },
    "status": {
      "type": "string",
      "enum": [
        "aktif",
        "baby",
        "sakit",
        "breeding",
        "mati",
        "terjual",
        "diarsipkan"
      ],
      "default": "aktif"
    },
    "previous_status": {
      "type": "string"
    },
    "is_currently_sick": {
      "type": "boolean",
      "default": false
    },
    "last_status_change": {
      "type": "string",
      "format": "date"
    },
    "enclosure_id": {
      "type": "string",
      "description": "Nomor kandang. Tautan yang sebenarnya — tidak berubah saat kandang diganti nama. Field enclosure di bawah tetap diisi sebagai keterangan yang terbaca manusia."
    },
    "enclosure": {
      "type": "string"
    },
    "in_quarantine": {
      "type": "boolean",
      "default": false
    },
    "quarantine_start_date": {
      "type": "string",
      "format": "date"
    },
    "quarantine_reason": {
      "type": "string",
      "enum": [
        "pendatang_baru",
        "sakit",
        "cedera",
        "observasi",
        "sebelum_dijual",
        "lainnya"
      ]
    },
    "quarantine_notes": {
      "type": "string"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "weight_grams": {
            "type": "number"
          },
          "shell_length_cm": {
            "type": "number"
          },
          "notes": {
            "type": "string"
          },
          "is_primary": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "death_date": {
      "type": "string",
      "format": "date",
      "description": "Tanggal kematian"
    },
    "death_cause": {
      "type": "string",
      "enum": [
        "sakit",
        "umur_tua",
        "kecelakaan",
        "predator",
        "stress",
        "egg_binding",
        "tidak_diketahui",
        "lainnya"
      ],
      "description": "Penyebab kematian"
    },
    "death_photos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Foto bukti kematian"
    },
    "death_notes": {
      "type": "string",
      "description": "Catatan kematian"
    },
    "necropsy_done": {
      "type": "boolean",
      "default": false,
      "description": "Apakah otopsi dilakukan"
    },
    "necropsy_findings": {
      "type": "string",
      "description": "Temuan otopsi"
    },
    "death_video_url": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "qr_code_url": {
      "type": "string"
    },
    "sale_channel": {
      "type": "string",
      "enum": [
        "Instagram",
        "Tokopedia",
        "Shopee",
        "WhatsApp",
        "Facebook",
        "Referral",
        "Langsung",
        "Lainnya"
      ]
    },
    "notes": {
      "type": "string"
    },
    "parent_male": {
      "type": "string"
    },
    "parent_female": {
      "type": "string"
    },
    "is_archived": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "name",
    "gender",
    "morph",
    "source",
    "status"
  ]
}