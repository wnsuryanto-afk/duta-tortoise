{
  "name": "Tortoise",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nama tortoise"
    },
    "code": {
      "type": "string",
      "description": "Kode identifikasi unik"
    },
    "gender": {
      "type": "string",
      "enum": [
        "jantan",
        "betina",
        "belum_diketahui"
      ],
      "default": "belum_diketahui",
      "description": "Jenis kelamin"
    },
    "morph": {
      "type": "string",
      "enum": [
        "normal",
        "over_scute",
        "less_scute",
        "het_albino",
        "ivory",
        "albino",
        "wc",
        "cb",
        "piebald",
        "genetic_stripe",
        "high_yellow",
        "dark",
        "paradox"
      ],
      "default": "normal",
      "description": "Jenis/morph kura-kura"
    },
    "source": {
      "type": "string",
      "enum": [
        "hasil_sendiri",
        "beli_lokal",
        "import"
      ],
      "default": "hasil_sendiri",
      "description": "Asal kura-kura"
    },
    "is_proven": {
      "type": "boolean",
      "default": false,
      "description": "Sudah proven"
    },
    "birth_date": {
      "type": "string",
      "format": "date",
      "description": "Tanggal lahir / menetas"
    },
    "purchase_date": {
      "type": "string",
      "format": "date",
      "description": "Tanggal pembelian"
    },
    "purchase_price": {
      "type": "number",
      "description": "Harga beli / HPP (Rp)"
    },
    "microchip_id": {
      "type": "string",
      "description": "Nomor microchip (jika ada)"
    },
    "weight_grams": {
      "type": "number",
      "description": "Berat dalam gram"
    },
    "shell_length_cm": {
      "type": "number",
      "description": "Panjang cangkang (cm)"
    },
    "status": {
      "type": "string",
      "enum": [
        "aktif",
        "baby",
        "sakit",
        "terjual",
        "mati"
      ],
      "default": "aktif",
      "description": "Status tortoise"
    },
    "enclosure": {
      "type": "string",
      "description": "Nama/nomor kandang"
    },
    "photo_url": {
      "type": "string",
      "description": "URL foto thumbnail utama"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          }
        }
      },
      "description": "Daftar foto tortoise"
    },
    "death_video_url": {
      "type": "string",
      "description": "URL video dokumentasi kematian"
    },
    "notes": {
      "type": "string",
      "description": "Catatan tambahan"
    },
    "parent_male": {
      "type": "string",
      "description": "ID induk jantan"
    },
    "parent_female": {
      "type": "string",
      "description": "ID induk betina"
    }
  },
  "required": [
    "name"
  ]
}