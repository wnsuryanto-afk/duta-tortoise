{
  "name": "Sale",
  "properties": {
    "buyer_address": {
      "type": "string"
    },
    "buyer_name": {
      "type": "string"
    },
    "buyer_profile_id": {
      "description": "Link ke BuyerProfile (auto-sync via hp_whatsapp)",
      "type": "string"
    },
    "care_cost_estimate": {
      "type": "number"
    },
    "certificate_number": {
      "type": "string"
    },
    "certificate_url": {
      "type": "string"
    },
    "dp_amount": {
      "type": "number"
    },
    "excluded_from_reports": {
      "default": false,
      "type": "boolean"
    },
    "finance_tx_id": {
      "type": "string"
    },
    "hp_whatsapp": {
      "description": "No. HP / WhatsApp pembeli",
      "type": "string"
    },
    "hpp": {
      "description": "HPP = modal + perawatan + obat + ongkir YANG DITANGGUNG PENJUAL. Bila ongkir_ditanggung = 'pembeli', ongkos kirim TIDAK masuk ke sini: pada kasus itu pengaruhnya ke laba nol, entah pembeli membayar kurir langsung atau menggantinya ke peternakan.",
      "type": "number"
    },
    "invoice_number": {
      "type": "string"
    },
    "invoice_url": {
      "type": "string"
    },
    "is_test_data": {
      "default": false,
      "type": "boolean"
    },
    "margin_percent": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    },
    "ongkir_ditanggung": {
      "default": "penjual",
      "description": "Siapa yang menanggung ongkos kirim. 'penjual' = masuk HPP dan memakan laba. 'pembeli' = tidak masuk HPP. Bawaannya 'penjual' karena itulah perilaku sebelum kolom ini ada, sehingga penjualan lama yang kolomnya kosong tetap dihitung persis seperti semula.",
      "enum": [
        "penjual",
        "pembeli"
      ],
      "type": "string"
    },
    "payment_proofs": {
      "description": "Bukti pembayaran",
      "items": {
        "properties": {
          "amount": {
            "type": "number"
          },
          "date": {
            "format": "date",
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "photo_url": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "payment_status": {
      "default": "lunas",
      "enum": [
        "lunas",
        "dp",
        "belum_bayar"
      ],
      "type": "string"
    },
    "platform": {
      "enum": [
        "Instagram",
        "Tokopedia",
        "Shopee",
        "WhatsApp",
        "Facebook",
        "Referral",
        "Langsung",
        "Lainnya"
      ],
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "profit": {
      "type": "number"
    },
    "purchase_price_original": {
      "type": "number"
    },
    "remaining_balance": {
      "type": "number"
    },
    "sale_date": {
      "format": "date",
      "type": "string"
    },
    "shipping_cost": {
      "default": 0,
      "description": "Ongkos kirim, apa adanya. Siapa yang menanggungnya ada di ongkir_ditanggung \u2014 angka ini sendiri tidak menentukan apakah ia masuk HPP.",
      "type": "number"
    },
    "shipping_method": {
      "default": "ambil_sendiri",
      "enum": [
        "ambil_sendiri",
        "kirim_kurir",
        "cargo"
      ],
      "type": "string"
    },
    "tortoise_code": {
      "type": "string"
    },
    "tortoise_id": {
      "type": "string"
    },
    "tortoise_name": {
      "type": "string"
    },
    "tortoise_species": {
      "type": "string"
    },
    "tortoise_weight": {
      "type": "number"
    },
    "total_paid": {
      "type": "number"
    }
  },
  "required": [
    "tortoise_id",
    "buyer_name",
    "sale_date",
    "price"
  ],
  "type": "object"
}