{
  "name": "Sale",
  "type": "object",
  "properties": {
    "tortoise_id": {
      "type": "string"
    },
    "tortoise_name": {
      "type": "string"
    },
    "buyer_name": {
      "type": "string"
    },
    "buyer_phone": {
      "type": "string"
    },
    "buyer_address": {
      "type": "string"
    },
    "sale_date": {
      "type": "string",
      "format": "date"
    },
    "price": {
      "type": "number"
    },
    "hpp": {
      "type": "number"
    },
    "dp_amount": {
      "type": "number"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "lunas",
        "dp",
        "belum_bayar"
      ],
      "default": "lunas"
    },
    "payment_proofs": {
      "type": "array",
      "description": "Bukti pembayaran (foto transfer, dsb)",
      "items": {
        "type": "object",
        "properties": {
          "photo_url": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "total_paid": {
      "type": "number",
      "description": "Total sudah dibayar (auto-sum dari payment_proofs)"
    },
    "remaining_balance": {
      "type": "number",
      "description": "Sisa pembayaran (price - total_paid)"
    },
    "shipping_method": {
      "type": "string",
      "enum": [
        "ambil_sendiri",
        "kirim_kurir",
        "cargo"
      ],
      "default": "ambil_sendiri"
    },
    "platform": {
      "type": "string",
      "enum": [
        "Instagram",
        "Tokopedia",
        "Shopee",
        "WhatsApp",
        "Facebook",
        "Referral",
        "Langsung",
        "Lainnya"
      ]
    },
    "is_repeat_buyer": {
      "type": "boolean",
      "default": false
    },
    "after_sale_status": {
      "type": "string",
      "enum": [
        "puas",
        "komplain",
        "no_response"
      ]
    },
    "complaint_detail": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "tortoise_name",
    "buyer_name",
    "price",
    "sale_date",
    "buyer_phone",
    "payment_status",
    "shipping_method"
  ]
}