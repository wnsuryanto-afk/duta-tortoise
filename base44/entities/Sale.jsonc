{
  "name": "Sale",
  "type": "object",
  "properties": {
    "tortoise_id": {
      "type": "string"
    },
    "tortoise_name": {
      "type": "string"
    },
    "buyer_name": {
      "type": "string"
    },
    "buyer_phone": {
      "type": "string"
    },
    "buyer_address": {
      "type": "string"
    },
    "buyer_profile_id": {
      "type": "string",
      "description": "Link ke BuyerProfile (auto-sync via buyer_phone)"
    },
    "sale_date": {
      "type": "string",
      "format": "date"
    },
    "price": {
      "type": "number"
    },
    "hpp": {
      "type": "number",
      "description": "HPP = harga modal + shipping_cost"
    },
    "shipping_cost": {
      "type": "number",
      "default": 0,
      "description": "Ongkos kirim"
    },
    "dp_amount": {
      "type": "number"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "lunas",
        "dp",
        "belum_bayar"
      ],
      "default": "lunas"
    },
    "payment_proofs": {
      "type": "array",
      "description": "Bukti pembayaran",
      "items": {
        "type": "object",
        "properties": {
          "photo_url": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "total_paid": {
      "type": "number"
    },
    "remaining_balance": {
      "type": "number"
    },
    "certificate_number": {
      "type": "string"
    },
    "certificate_url": {
      "type": "string"
    },
    "invoice_number": {
      "type": "string"
    },
    "invoice_url": {
      "type": "string"
    },
    "shipping_method": {
      "type": "string",
      "enum": [
        "ambil_sendiri",
        "kirim_kurir",
        "cargo"
      ],
      "default": "ambil_sendiri"
    },
    "platform": {
      "type": "string",
      "enum": [
        "Instagram",
        "Tokopedia",
        "Shopee",
        "WhatsApp",
        "Facebook",
        "Referral",
        "Langsung",
        "Lainnya"
      ]
    },
    "is_repeat_buyer": {
      "type": "boolean",
      "default": false
    },
    "after_sale_status": {
      "type": "string",
      "enum": [
        "puas",
        "komplain",
        "no_response"
      ]
    },
    "complaint_detail": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "excluded_from_reports": {
      "type": "boolean",
      "default": false,
      "description": "Dikecualikan dari laporan (owner only)"
    }
  },
  "required": [
    "tortoise_name",
    "buyer_name",
    "price",
    "sale_date",
    "buyer_phone",
    "payment_status",
    "shipping_method"
  ]
}