{
  "name": "Sale",
  "type": "object",
  "properties": {
    "tortoise_id": {
      "type": "string",
      "description": "ID tortoise yang dijual"
    },
    "tortoise_name": {
      "type": "string",
      "description": "Nama/kode tortoise"
    },
    "buyer_name": {
      "type": "string",
      "description": "Nama pembeli"
    },
    "buyer_phone": {
      "type": "string",
      "description": "Nomor telepon pembeli"
    },
    "buyer_address": {
      "type": "string",
      "description": "Alamat pembeli"
    },
    "sale_date": {
      "type": "string",
      "format": "date",
      "description": "Tanggal penjualan"
    },
    "price": {
      "type": "number",
      "description": "Harga jual (Rp)"
    },
    "hpp": {
      "type": "number",
      "description": "HPP / Modal (Rp)"
    },
    "dp_amount": {
      "type": "number",
      "description": "Jumlah DP yang dibayar (Rp)"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "lunas",
        "dp",
        "belum_bayar"
      ],
      "default": "lunas",
      "description": "Status pembayaran"
    },
    "shipping_method": {
      "type": "string",
      "enum": [
        "ambil_sendiri",
        "kirim_kurir",
        "cargo"
      ],
      "default": "ambil_sendiri"
    },
    "certificate_number": {
      "type": "string",
      "description": "Nomor surat jual beli"
    },
    "certificate_url": {
      "type": "string",
      "description": "URL scan surat jual beli"
    },
    "platform": {
      "type": "string",
      "description": "Platform/channel penjualan (Instagram, Tokopedia, WhatsApp, Langsung, dll)"
    },
    "is_repeat_buyer": {
      "type": "boolean",
      "default": false,
      "description": "Pembeli lama / repeat buyer"
    },
    "after_sale_status": {
      "type": "string",
      "enum": [
        "puas",
        "komplain",
        "no_response"
      ],
      "description": "Status after sales"
    },
    "complaint_detail": {
      "type": "string",
      "description": "Detail komplain jika ada"
    },
    "notes": {
      "type": "string",
      "description": "Catatan"
    }
  },
  "required": [
    "tortoise_name",
    "buyer_name",
    "price",
    "sale_date"
  ]
}