{
  "name": "CCTVCamera",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nama kamera, contoh: Kandang A"
    },
    "stream_url": {
      "type": "string",
      "description": "URL stream MJPEG/RTSP/HLS"
    },
    "location": {
      "type": "string",
      "description": "Lokasi kamera"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "brand": {
      "type": "string",
      "description": "Merk kamera (Hikvision, Dahua, Reolink, Ezviz, dll)"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "stream_url"
  ]
}