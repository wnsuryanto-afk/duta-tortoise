{
  "name": "FinanceTransaction",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "pemasukan",
        "pengeluaran"
      ]
    },
    "category": {
      "type": "string",
      "enum": [
        "penjualan_tortoise",
        "gaji_karyawan",
        "obat_perawatan",
        "vitamin_suplemen",
        "pakan",
        "operasional",
        "kas_kecil",
        "lainnya"
      ]
    },
    "sub_category": {
      "type": "string",
      "description": "Detail sub-kategori"
    },
    "amount": {
      "type": "number"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "description": {
      "type": "string"
    },
    "reference_id": {
      "type": "string"
    },
    "enclosure_name": {
      "type": "string",
      "description": "Alokasi biaya ke kandang tertentu (opsional)"
    },
    "created_by_name": {
      "type": "string"
    },
    "excluded_from_reports": {
      "type": "boolean",
      "default": false,
      "description": "Dikecualikan dari laporan (owner only)"
    },
    "is_test_data": {
      "type": "boolean",
      "default": false,
      "description": "Ditandai sebagai data test \u2014 tidak masuk laporan"
    }
  },
  "required": [
    "type",
    "category",
    "amount",
    "date",
    "description"
  ]
}