{
  "name": "FinanceTransaction",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "pemasukan",
        "pengeluaran"
      ]
    },
    "category": {
      "type": "string",
      "enum": [
        "penjualan_tortoise",
        "pembelian_barang",
        "gaji_karyawan",
        "operasional",
        "lainnya"
      ]
    },
    "amount": {
      "type": "number"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "description": {
      "type": "string"
    },
    "reference_id": {
      "type": "string"
    },
    "created_by_name": {
      "type": "string"
    }
  },
  "required": [
    "type",
    "category",
    "amount",
    "date",
    "description"
  ]
}