{
  "name": "FinanceTransaction",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "pemasukan",
        "pengeluaran"
      ]
    },
    "category": {
      "type": "string",
      "enum": [
        "penjualan_tortoise",
        "gaji_karyawan",
        "obat_perawatan",
        "vitamin_suplemen",
        "pakan",
        "operasional",
        "solar_bbm",
        "rokok",
        "kas_kecil",
        "listrik",
        "air",
        "perawatan_kandang",
        "lainnya"
      ]
    },
    "sub_category": {
      "type": "string",
      "description": "Detail sub-kategori"
    },
    "qty": {
      "type": "number",
      "description": "Jumlah unit (opsional, default 1)"
    },
    "harga_satuan": {
      "type": "number",
      "description": "Harga per unit (Rp)"
    },
    "amount": {
      "type": "number",
      "description": "Total nominal = qty \u00d7 harga_satuan"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "description": {
      "type": "string"
    },
    "reference_id": {
      "type": "string"
    },
    "invoice_photo_url": {
      "type": "string",
      "description": "URL lampiran foto/screenshot invoice (AI Vision) untuk penelusuran"
    },
    "enclosure_name": {
      "type": "string",
      "description": "Alokasi biaya ke kandang tertentu (opsional)"
    },
    "created_by_name": {
      "type": "string"
    },
    "edited_by": {
      "type": "string",
      "description": "Nama user yang terakhir edit"
    },
    "edited_at": {
      "type": "string",
      "format": "date-time",
      "description": "Waktu terakhir diedit"
    },
    "excluded_from_reports": {
      "type": "boolean",
      "default": false,
      "description": "Dikecualikan dari laporan (owner only)"
    },
    "is_test_data": {
      "type": "boolean",
      "default": false,
      "description": "Ditandai sebagai data test \u2014 tidak masuk laporan"
    }
  },
  "required": [
    "type",
    "category",
    "amount",
    "date",
    "description"
  ]
}