{
  "name": "FeedingLog",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date",
      "description": "Tanggal pemberian pakan"
    },
    "enclosure_id": {
      "type": "string",
      "description": "ID kandang"
    },
    "enclosure_name": {
      "type": "string",
      "description": "Nama kandang"
    },
    "fed_by_email": {
      "type": "string",
      "description": "Email keeper yang memberi pakan"
    },
    "fed_by_name": {
      "type": "string",
      "description": "Nama keeper yang memberi pakan"
    },
    "feed_items": {
      "type": "array",
      "description": "Daftar pakan yang diberikan",
      "items": {
        "type": "object",
        "properties": {
          "feedstock_id": {
            "type": "string"
          },
          "feedstock_name": {
            "type": "string"
          },
          "feedstock_sku": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          },
          "is_checked": {
            "type": "boolean",
            "default": true
          }
        }
      }
    },
    "notes": {
      "type": "string"
    },
    "total_items_checked": {
      "type": "number",
      "default": 0,
      "description": "Jumlah item pakan yang dicentang"
    }
  },
  "required": [
    "date",
    "fed_by_email",
    "fed_by_name"
  ]
}