{
  "name": "Breeding",
  "properties": {
    "candling_day_30_date": {
      "format": "date",
      "type": "string"
    },
    "candling_day_30_done": {
      "default": false,
      "type": "boolean"
    },
    "candling_notes": {
      "items": {
        "properties": {
          "date": {
            "format": "date",
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "result": {
            "enum": [
              "fertile",
              "infertile",
              "unclear"
            ],
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "clutch_number": {
      "type": "number"
    },
    "completed_date": {
      "description": "Tanggal inkubasi diselesaikan",
      "format": "date",
      "type": "string"
    },
    "egg_count": {
      "type": "number"
    },
    "egg_laying_date": {
      "format": "date",
      "type": "string"
    },
    "egg_records": {
      "description": "Status tracking per butir telur",
      "items": {
        "properties": {
          "check_date": {
            "format": "date",
            "type": "string"
          },
          "egg_number": {
            "type": "number"
          },
          "hatch_date": {
            "format": "date",
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "retak": {
            "default": false,
            "description": "Cangkangnya retak. BUKAN status \u2014 telur retak tetap punya status fertilitasnya sendiri dan masih bisa menetas. Dijadikan status akan mengeluarkannya dari hitungan fertil/infertil/menetas dan membuat pertanyaan terpenting \u2014 apakah yang retak itu selamat \u2014 tidak bisa dijawab.",
            "type": "boolean"
          },
          "retak_catatan": {
            "description": "Perlakuan yang diberikan pada telur retak (mis. ditutup lilin/lem, dipisah tray).",
            "type": "string"
          },
          "retak_date": {
            "description": "Tanggal retaknya diketahui. Kosong untuk yang dicatat sejak hari bertelur.",
            "format": "date",
            "type": "string"
          },
          "status": {
            "enum": [
              "belum_dicek",
              "fertile",
              "infertil",
              "menetas",
              "gagal"
            ],
            "type": "string"
          },
          "tortoise_code": {
            "description": "Kode bayi (BB-YYYYNNN) untuk tampilan cepat",
            "type": "string"
          },
          "tortoise_id": {
            "description": "ID Tortoise yang dibuat saat telur menetas",
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "egg_weight_grams": {
      "type": "number"
    },
    "estimated_hatch_date": {
      "format": "date",
      "type": "string"
    },
    "estimated_hatch_end": {
      "description": "Estimasi selesai menetas (egg_laying_date + 105 hari)",
      "format": "date",
      "type": "string"
    },
    "estimated_hatch_start": {
      "description": "Estimasi mulai menetas (egg_laying_date + 80 hari)",
      "format": "date",
      "type": "string"
    },
    "failed_count": {
      "type": "number"
    },
    "female_id": {
      "type": "string"
    },
    "female_name": {
      "type": "string"
    },
    "fertile_count": {
      "description": "Jumlah telur fertile (termasuk yang menetas)",
      "type": "number"
    },
    "hatch_date": {
      "format": "date",
      "type": "string"
    },
    "hatch_rate": {
      "description": "Hatch rate (%) = menetas / egg_count x 100",
      "type": "number"
    },
    "hatched_count": {
      "type": "number"
    },
    "incubation_humidity": {
      "type": "number"
    },
    "incubation_temp": {
      "type": "number"
    },
    "incubator_id": {
      "description": "Inkubator tempat telur ini dierami. Tanpa ini, satu-satunya penghubung clutch ke inkubator adalah namanya \u2014 ganti nama inkubatornya dan seluruh clutch di dalamnya lepas tanpa suara.",
      "type": "string"
    },
    "incubator_name": {
      "description": "Nama inkubator (diambil dari entity Incubator)",
      "type": "string"
    },
    "induk_perkiraan": {
      "default": false,
      "description": "Induknya hanya PERKIRAAN, bukan diketahui pasti. Dipakai untuk telur yang ditemukan saat menggali tanah: telurnya nyata, tapi tidak ada yang melihat betina mana yang bertelur. Clutch bertanda ini TETAP dihitung sebagai produksi kebun (jumlah telur, isi inkubator, daya tetas kebun) tetapi TIDAK PERNAH dipakai menilai seekor indukan — Ranking Indukan dan produksiBetina melewatinya. Mengkreditkan telur kepada betina yang belum tentu bertelur akan membuat keputusan 'indukan mana yang produktif' diambil dari angka karangan. Aturannya di src/lib/indukPerkiraan.js, dijaga scripts/cek-induk.mjs.",
      "type": "boolean"
    },
    "tanggal_perkiraan": {
      "default": false,
      "description": "egg_laying_date hanya PERKIRAAN. Untuk telur yang ditemukan terkubur, tanggal bertelurnya ditaksir — misalnya dari kapan terakhir area itu digali atau dari tingkat perkembangan embrio saat disenter. Jendela menetas (+80/+105 hari) yang dihitung darinya ikut perkiraan, jadi layar harus menyebutnya perkiraan dan bukan tanggal pasti.",
      "type": "boolean"
    },
    "infertile_count": {
      "description": "Jumlah telur infertil",
      "type": "number"
    },
    "is_archived": {
      "default": false,
      "description": "Apakah data sudah diarsipkan",
      "type": "boolean"
    },
    "male_id": {
      "type": "string"
    },
    "male_name": {
      "type": "string"
    },
    "mating_date": {
      "format": "date",
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "photos": {
      "items": {
        "properties": {
          "url": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "season_year": {
      "type": "number"
    },
    "status": {
      "default": "bertelur",
      "enum": [
        "bertelur",
        "inkubasi",
        "menetas",
        "gagal",
        "selesai"
      ],
      "type": "string"
    },
    "tray_number": {
      "description": "LAMA \u2014 satu nomor tray saja. Dipertahankan supaya catatan sebelum 02-10-2026 tidak kehilangan traynya. Pengisian baru memakai tray_numbers; pembacaan memakai tray_numbers lebih dulu lalu jatuh ke kolom ini.",
      "type": "number"
    },
    "tray_numbers": {
      "description": "Nomor tray yang dipakai clutch ini. Satu clutch bisa memakai LEBIH DARI SATU tray \u2014 clutch 28 butir tidak muat di satu tray. Ditambahkan 02-10-2026 saat kebun punya 32 tray.",
      "items": {
        "type": "number"
      },
      "type": "array"
    }
  },
  "required": [
    "male_name",
    "female_name",
    "egg_laying_date",
    "egg_count",
    "status",
    "season_year",
    "incubator_name"
  ],
  "type": "object"
}