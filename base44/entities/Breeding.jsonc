{
  "name": "Breeding",
  "type": "object",
  "properties": {
    "male_id": {
      "type": "string",
      "description": "ID tortoise jantan"
    },
    "female_id": {
      "type": "string",
      "description": "ID tortoise betina"
    },
    "male_name": {
      "type": "string",
      "description": "Nama tortoise jantan"
    },
    "female_name": {
      "type": "string",
      "description": "Nama tortoise betina"
    },
    "clutch_number": {
      "type": "number",
      "description": "Urutan clutch dari pasangan ini di tahun ini"
    },
    "season_year": {
      "type": "number",
      "description": "Tahun musim kawin"
    },
    "mating_date": {
      "type": "string",
      "format": "date",
      "description": "Tanggal kawin"
    },
    "egg_laying_date": {
      "type": "string",
      "format": "date",
      "description": "Tanggal bertelur"
    },
    "egg_count": {
      "type": "number",
      "description": "Jumlah telur"
    },
    "egg_weight_grams": {
      "type": "number",
      "description": "Berat telur rata-rata (gram)"
    },
    "estimated_hatch_date": {
      "type": "string",
      "format": "date",
      "description": "Perkiraan tanggal menetas (~105 hari)"
    },
    "hatch_date": {
      "type": "string",
      "format": "date",
      "description": "Tanggal aktual menetas"
    },
    "hatched_count": {
      "type": "number",
      "description": "Jumlah yang berhasil menetas"
    },
    "failed_count": {
      "type": "number",
      "description": "Jumlah telur yang gagal menetas"
    },
    "status": {
      "type": "string",
      "enum": [
        "bertelur",
        "inkubasi",
        "menetas",
        "gagal"
      ],
      "default": "bertelur"
    },
    "incubation_temp": {
      "type": "number",
      "description": "Suhu inkubasi (\u00b0C)"
    },
    "incubation_humidity": {
      "type": "number",
      "description": "Kelembapan inkubasi (%)"
    },
    "candling_notes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "result": {
            "type": "string",
            "enum": [
              "fertile",
              "infertile",
              "unclear"
            ]
          },
          "notes": {
            "type": "string"
          }
        }
      },
      "description": "Catatan candling berkala"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          }
        }
      },
      "description": "Foto dokumentasi telur / breeding"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "male_name",
    "female_name"
  ]
}