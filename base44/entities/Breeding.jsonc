{
  "name": "Breeding",
  "type": "object",
  "properties": {
    "male_id": {
      "type": "string",
      "description": "ID tortoise jantan"
    },
    "female_id": {
      "type": "string",
      "description": "ID tortoise betina"
    },
    "male_name": {
      "type": "string",
      "description": "Nama tortoise jantan"
    },
    "female_name": {
      "type": "string",
      "description": "Nama tortoise betina"
    },
    "egg_laying_date": {
      "type": "string",
      "format": "date",
      "description": "Tanggal bertelur"
    },
    "egg_count": {
      "type": "number",
      "description": "Jumlah telur"
    },
    "estimated_hatch_date": {
      "type": "string",
      "format": "date",
      "description": "Perkiraan tanggal menetas (~105 hari)"
    },
    "hatch_date": {
      "type": "string",
      "format": "date",
      "description": "Tanggal aktual menetas"
    },
    "hatched_count": {
      "type": "number",
      "description": "Jumlah yang berhasil menetas"
    },
    "failed_count": {
      "type": "number",
      "description": "Jumlah telur yang gagal menetas"
    },
    "status": {
      "type": "string",
      "enum": [
        "bertelur",
        "inkubasi",
        "menetas",
        "gagal"
      ],
      "default": "bertelur",
      "description": "Status breeding"
    },
    "incubation_temp": {
      "type": "number",
      "description": "Suhu inkubasi (\u00b0C)"
    },
    "notes": {
      "type": "string",
      "description": "Catatan"
    }
  },
  "required": [
    "male_name",
    "female_name"
  ]
}