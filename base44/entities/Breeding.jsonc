{
  "name": "Breeding",
  "type": "object",
  "properties": {
    "male_id": {
      "type": "string"
    },
    "female_id": {
      "type": "string"
    },
    "male_name": {
      "type": "string"
    },
    "female_name": {
      "type": "string"
    },
    "clutch_number": {
      "type": "number"
    },
    "season_year": {
      "type": "number"
    },
    "mating_date": {
      "type": "string",
      "format": "date"
    },
    "egg_laying_date": {
      "type": "string",
      "format": "date"
    },
    "egg_count": {
      "type": "number"
    },
    "egg_weight_grams": {
      "type": "number"
    },
    "estimated_hatch_date": {
      "type": "string",
      "format": "date"
    },
    "hatch_date": {
      "type": "string",
      "format": "date"
    },
    "hatched_count": {
      "type": "number"
    },
    "failed_count": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "bertelur",
        "inkubasi",
        "menetas",
        "gagal"
      ],
      "default": "bertelur"
    },
    "incubation_temp": {
      "type": "number"
    },
    "incubation_humidity": {
      "type": "number"
    },
    "candling_notes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "result": {
            "type": "string",
            "enum": [
              "fertile",
              "infertile",
              "unclear"
            ]
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          }
        }
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "male_name",
    "female_name",
    "egg_laying_date",
    "egg_count",
    "status",
    "season_year"
  ]
}