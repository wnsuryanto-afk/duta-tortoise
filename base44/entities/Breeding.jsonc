{
  "name": "Breeding",
  "type": "object",
  "required": [
    "male_name",
    "female_name",
    "egg_laying_date",
    "egg_count",
    "status",
    "season_year",
    "incubator_name"
  ],
  "properties": {
    "male_id": {
      "type": "string"
    },
    "female_id": {
      "type": "string"
    },
    "male_name": {
      "type": "string"
    },
    "female_name": {
      "type": "string"
    },
    "clutch_number": {
      "type": "number"
    },
    "season_year": {
      "type": "number"
    },
    "mating_date": {
      "type": "string",
      "format": "date"
    },
    "egg_laying_date": {
      "type": "string",
      "format": "date"
    },
    "egg_count": {
      "type": "number"
    },
    "egg_weight_grams": {
      "type": "number"
    },
    "incubator_name": {
      "type": "string",
      "description": "Nama inkubator (diambil dari entity Incubator)"
    },
    "tray_number": {
      "type": "number",
      "description": "Nomor Tray (opsional)"
    },
    "estimated_hatch_start": {
      "type": "string",
      "format": "date",
      "description": "Estimasi mulai menetas (egg_laying_date + 80 hari)"
    },
    "estimated_hatch_end": {
      "type": "string",
      "format": "date",
      "description": "Estimasi selesai menetas (egg_laying_date + 105 hari)"
    },
    "estimated_hatch_date": {
      "type": "string",
      "format": "date"
    },
    "hatch_date": {
      "type": "string",
      "format": "date"
    },
    "hatched_count": {
      "type": "number"
    },
    "failed_count": {
      "type": "number"
    },
    "fertile_count": {
      "type": "number",
      "description": "Jumlah telur fertile (termasuk yang menetas)"
    },
    "infertile_count": {
      "type": "number",
      "description": "Jumlah telur infertil"
    },
    "hatch_rate": {
      "type": "number",
      "description": "Hatch rate (%) = menetas / egg_count x 100"
    },
    "completed_date": {
      "type": "string",
      "format": "date",
      "description": "Tanggal inkubasi diselesaikan"
    },
    "status": {
      "type": "string",
      "enum": [
        "bertelur",
        "inkubasi",
        "menetas",
        "gagal",
        "selesai"
      ],
      "default": "bertelur"
    },
    "incubation_temp": {
      "type": "number"
    },
    "incubation_humidity": {
      "type": "number"
    },
    "egg_records": {
      "type": "array",
      "description": "Status tracking per butir telur",
      "items": {
        "type": "object",
        "properties": {
          "egg_number": {
            "type": "number"
          },
          "status": {
            "type": "string",
            "enum": [
              "belum_dicek",
              "fertile",
              "infertil",
              "menetas",
              "gagal"
            ]
          },
          "check_date": {
            "type": "string",
            "format": "date"
          },
          "hatch_date": {
            "type": "string",
            "format": "date"
          },
          "tortoise_id": {
            "type": "string",
            "description": "ID Tortoise yang dibuat saat telur menetas"
          },
          "tortoise_code": {
            "type": "string",
            "description": "Kode bayi (BB-YYYYNNN) untuk tampilan cepat"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "candling_day_30_done": {
      "type": "boolean",
      "default": false
    },
    "candling_day_30_date": {
      "type": "string",
      "format": "date"
    },
    "candling_notes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "result": {
            "type": "string",
            "enum": [
              "fertile",
              "infertile",
              "unclear"
            ]
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          }
        }
      }
    },
    "notes": {
      "type": "string"
    },
    "is_archived": {
      "type": "boolean",
      "default": false,
      "description": "Apakah data sudah diarsipkan"
    }
  }
}