{
  "name": "FeedSchedule",
  "type": "object",
  "properties": {
    "enclosure_id": {
      "type": "string",
      "description": "ID kandang"
    },
    "enclosure_name": {
      "type": "string",
      "description": "Nama kandang"
    },
    "feed_time": {
      "type": "string",
      "enum": [
        "pagi",
        "siang",
        "sore"
      ],
      "description": "Waktu pemberian pakan"
    },
    "feed_time_hour": {
      "type": "string",
      "description": "Jam spesifik (e.g., 07:00)"
    },
    "feed_type": {
      "type": "string",
      "description": "Jenis pakan (rumput segar, pellet, sayur)"
    },
    "feed_quantity": {
      "type": "string",
      "description": "Jumlah/porsi (e.g., 2 ikat, 200 gram)"
    },
    "days_active": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "senin",
          "selasa",
          "rabu",
          "kamis",
          "jumat",
          "sabtu",
          "minggu"
        ]
      },
      "description": "Hari aktif"
    },
    "assigned_to": {
      "type": "string",
      "description": "Karyawan yang bertanggung jawab"
    },
    "last_fed": {
      "type": "string",
      "format": "date",
      "description": "Terakhir diberi pakan"
    },
    "notes": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "enclosure_id",
    "enclosure_name",
    "feed_time"
  ]
}