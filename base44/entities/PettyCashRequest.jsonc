{
  "name": "PettyCashRequest",
  "type": "object",
  "properties": {
    "requester_email": {
      "type": "string"
    },
    "requester_name": {
      "type": "string"
    },
    "amount_requested": {
      "type": "number"
    },
    "reason": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "obat",
        "vitamin",
        "pakan",
        "peralatan_kandang",
        "transportasi",
        "lainnya"
      ],
      "default": "lainnya"
    },
    "need_date": {
      "type": "string",
      "format": "date",
      "description": "Tanggal dibutuhkan"
    },
    "proof_photo": {
      "type": "string",
      "description": "URL foto bukti/nota"
    },
    "urgency": {
      "type": "string",
      "enum": [
        "normal",
        "mendesak"
      ],
      "default": "normal"
    },
    "request_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "disbursed"
      ],
      "default": "pending"
    },
    "approved_by": {
      "type": "string"
    },
    "approved_date": {
      "type": "string",
      "format": "date"
    },
    "disbursement_date": {
      "type": "string",
      "format": "date"
    },
    "disbursement_method": {
      "type": "string",
      "enum": [
        "transfer",
        "tunai"
      ],
      "description": "Metode pencairan: transfer (dengan bukti) atau tunai"
    },
    "disbursement_proof_url": {
      "type": "string",
      "description": "URL bukti transfer (screenshot m-banking)"
    },
    "disbursement_proof_uploaded_at": {
      "type": "string",
      "format": "date-time",
      "description": "Waktu upload bukti transfer"
    },
    "disbursement_proof_uploaded_by": {
      "type": "string",
      "description": "Nama yang mengupload bukti transfer"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "requester_email",
    "requester_name",
    "amount_requested",
    "reason",
    "request_date"
  ]
}