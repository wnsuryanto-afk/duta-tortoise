{
  "name": "Incubator",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nama inkubator"
    },
    "capacity_eggs": {
      "type": "number",
      "description": "Kapasitas maksimal telur"
    },
    "current_eggs": {
      "type": "number",
      "default": 0,
      "description": "Jumlah telur saat ini"
    },
    "temp_setting": {
      "type": "number",
      "description": "Suhu setting \u00b0C"
    },
    "humidity_setting": {
      "type": "number",
      "description": "Kelembapan setting %"
    },
    "brand": {
      "type": "string",
      "description": "Merk inkubator"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "notes": {
      "type": "string"
    },
    "temp_min_alarm": {
      "type": "number",
      "default": 31,
      "description": "Alarm suhu minimum \u00b0C"
    },
    "temp_max_alarm": {
      "type": "number",
      "default": 32,
      "description": "Alarm suhu maksimum \u00b0C"
    },
    "humidity_min_alarm": {
      "type": "number",
      "default": 70,
      "description": "Alarm kelembapan minimum %"
    },
    "humidity_max_alarm": {
      "type": "number",
      "default": 90,
      "description": "Alarm kelembapan maksimum %"
    },
    "mode": {
      "type": "string",
      "enum": [
        "manual",
        "auto"
      ],
      "default": "manual",
      "description": "Mode pembacaan inkubator"
    },
    "api_endpoint": {
      "type": "string",
      "description": "URL endpoint API sensor (mode auto)"
    },
    "api_key": {
      "type": "string",
      "description": "API key sensor (mode auto)"
    },
    "refresh_interval_seconds": {
      "type": "number",
      "default": 60,
      "description": "Interval refresh data auto (detik)"
    }
  },
  "required": [
    "name"
  ]
}