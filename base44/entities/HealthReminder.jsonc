{
  "name": "HealthReminder",
  "type": "object",
  "properties": {
    "tortoise_id": {
      "type": "string",
      "description": "ID kura-kura (kosongkan untuk semua kura-kura)"
    },
    "tortoise_name": {
      "type": "string",
      "description": "Nama kura-kura (atau 'Semua Kura-kura')"
    },
    "type": {
      "type": "string",
      "enum": [
        "vitamin",
        "checkup",
        "obat",
        "vaksin",
        "timbang",
        "lainnya"
      ],
      "default": "checkup",
      "description": "Jenis pengingat"
    },
    "title": {
      "type": "string",
      "description": "Judul pengingat"
    },
    "notes": {
      "type": "string",
      "description": "Catatan tambahan"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "Tanggal jatuh tempo"
    },
    "interval_days": {
      "type": "number",
      "description": "Interval pengulangan (hari). Kosongkan jika tidak berulang."
    },
    "is_done": {
      "type": "boolean",
      "default": false,
      "description": "Sudah ditandai selesai"
    },
    "done_date": {
      "type": "string",
      "format": "date",
      "description": "Tanggal diselesaikan"
    },
    "enclosure": {
      "type": "string",
      "description": "Kandang (opsional, untuk filter per area)"
    },
    "notif_sent": {
      "type": "boolean",
      "default": false,
      "description": "Flag notifikasi sudah dikirim agar tidak duplikat"
    },
    "notif_sent_date": {
      "type": "string",
      "format": "date",
      "description": "Tanggal notifikasi terakhir dikirim"
    }
  },
  "required": [
    "title",
    "due_date",
    "type"
  ]
}