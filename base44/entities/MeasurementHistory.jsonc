{
  "name": "MeasurementHistory",
  "type": "object",
  "properties": {
    "tortoise_id": {
      "type": "string",
      "description": "ID kura-kura"
    },
    "tortoise_name": {
      "type": "string",
      "description": "Nama kura-kura"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Tanggal pengukuran"
    },
    "weight_grams": {
      "type": "number",
      "description": "Berat (gram)"
    },
    "shell_length_cm": {
      "type": "number",
      "description": "Panjang cangkang (cm)"
    },
    "measured_by": {
      "type": "string",
      "description": "Nama pengukur"
    },
    "notes": {
      "type": "string",
      "description": "Catatan"
    }
  },
  "required": [
    "tortoise_id",
    "tortoise_name",
    "date"
  ]
}