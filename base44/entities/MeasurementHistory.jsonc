{
  "name": "MeasurementHistory",
  "type": "object",
  "properties": {
    "tortoise_id": {
      "type": "string"
    },
    "tortoise_name": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "weight_grams": {
      "type": "number"
    },
    "shell_length_cm": {
      "type": "number"
    },
    "measured_by": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "photo_url": {
      "type": "string",
      "description": "URL foto bukti timbang (opsional). Otomatis didorong ke galeri profil Tortoise oleh trigger onMeasurementSaved."
    },
    "excluded_from_reports": {
      "type": "boolean",
      "default": false,
      "description": "Dikecualikan dari laporan (owner only)"
    },
    "is_test_data": {
      "type": "boolean",
      "default": false,
      "description": "Ditandai sebagai data test \u2014 tidak masuk laporan"
    }
  },
  "required": [
    "tortoise_id",
    "tortoise_name",
    "date",
    "weight_grams"
  ]
}