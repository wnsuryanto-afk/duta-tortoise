{
  "name": "TortoiseTag",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nama tag"
    },
    "color": {
      "type": "string",
      "description": "Warna hex (e.g., #FFD700)"
    },
    "description": {
      "type": "string",
      "description": "Deskripsi tag"
    },
    "icon": {
      "type": "string",
      "description": "Emoji atau ikon"
    },
    "created_by": {
      "type": "string",
      "description": "Dibuat oleh"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "color"
  ]
}