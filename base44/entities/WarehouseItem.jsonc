{
  "name": "WarehouseItem",
  "properties": {
    "batch_number": {
      "type": "string"
    },
    "botol_terbuka": {
      "default": 0,
      "description": "Berapa botol/vial multi-dosis yang sudah ditusuk dan sedang dipakai. Yang menua pada obat suntik multi-dosis adalah BOTOLNYA, bukan dosisnya: sekali tutup karetnya ditembus jarum, isinya hanya aman beberapa minggu meski dosis tersisa masih banyak. Stok dihitung dalam dosis (mis. Vitamin B Kompleks 505 ampul dari 5 botol 100 ml), jadi tanpa kolom ini aplikasi mengira masih ada 505 dosis padahal yang menentukan adalah berapa botol sudah dibuka dan kapan.",
      "type": "number"
    },
    "category": {
      "default": "lainnya",
      "enum": [
        "obat",
        "vitamin",
        "suplemen",
        "habis_pakai",
        "alat_kerja",
        "peralatan",
        "lainnya"
      ],
      "type": "string"
    },
