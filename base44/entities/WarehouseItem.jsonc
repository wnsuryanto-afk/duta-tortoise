    },
    "harga_perkiraan": {
      "default": false,
      "description": "True bila purchase_price adalah TAKSIRAN harga pasaran, bukan angka dari nota/pesanan yang tercatat. Diisi 25-10-2026 untuk 53 barang yang masuk gudang sebagai inventaris awal tanpa pernah melewati alur pembelian: tidak ada nota, pesanan, maupun batch untuk satu pun dari mereka. Tanpa penanda ini, taksiran dan angka terverifikasi terlihat sama persis, dan bilah kelengkapan di beranda akan berbunyi 100% untuk data yang separuhnya tebakan. Alur Barang Datang mengosongkannya kembali begitu harga sungguhan masuk.",
      "type": "boolean"
    },
    "hari_pakai_setelah_dibuka": {
      "description": "Berapa hari isi botol masih boleh dipakai setelah tutupnya dibuka/ditusuk pertama kali. Hanya diisi untuk botol multi-dosis (mis. vial injeksi 100 dosis). Kosong berarti aturan ini tidak berlaku dan hanya tanggal cetak yang dipakai. ANGKANYA DARI DOKTER HEWAN, bukan dari aplikasi - jangan diisi dengan tebakan.",
      "type": "number"
    },
    "is_mandatory": {
      "default": false,
      "description": "Barang wajib tersedia, ada alert jika stok < minimum",
      "type": "boolean"
    },
    "last_edited_at": {
      "description": "Waktu terakhir edit",
      "format": "date-time",
      "type": "string"
    },
