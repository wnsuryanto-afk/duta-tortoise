{
  "name": "WarehouseItem",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "code": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "obat",
        "vitamin",
        "pakan",
        "alat_kerja",
        "lainnya"
      ],
      "default": "lainnya"
    },
    "unit": {
      "type": "string",
      "enum": [
        "pcs",
        "botol",
        "sachet",
        "kg",
        "gram",
        "liter",
        "ml",
        "ikat",
        "buah",
        "lusin",
        "box"
      ],
      "default": "pcs"
    },
    "current_stock": {
      "type": "number",
      "default": 0
    },
    "minimum_stock": {
      "type": "number",
      "default": 1
    },
    "purchase_price": {
      "type": "number",
      "default": 0
    },
    "supplier": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "expired_date": {
      "type": "string",
      "format": "date"
    },
    "batch_number": {
      "type": "string"
    },
    "restock_reminder_days": {
      "type": "number",
      "default": 7
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "unit",
    "current_stock",
    "minimum_stock",
    "category",
    "purchase_price"
  ]
}