{
  "name": "WarehouseItem",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "code": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "obat",
        "vitamin",
        "suplemen",
        "pakan",
        "alat_kerja",
        "peralatan",
        "lainnya"
      ],
      "default": "lainnya"
    },
    "unit": {
      "type": "string",
      "enum": [
        "pcs",
        "botol",
        "sachet",
        "kg",
        "gram",
        "liter",
        "ml",
        "ikat",
        "buah",
        "lusin",
        "box",
        "strip"
      ],
      "default": "pcs"
    },
    "current_stock": {
      "type": "number",
      "default": 0
    },
    "minimum_stock": {
      "type": "number",
      "default": 1
    },
    "purchase_price": {
      "type": "number",
      "default": 0
    },
    "is_mandatory": {
      "type": "boolean",
      "default": false,
      "description": "Barang wajib tersedia, ada alert jika stok < minimum"
    },
    "supplier": {
      "type": "string"
    },
    "location": {
      "type": "string",
      "enum": [
        "gudang_utama",
        "gazebo",
        "lemari_obat",
        "kulkas",
        "rak_vitamin",
        "gudang_alat"
      ],
      "default": "gudang_utama"
    },
    "expired_date": {
      "type": "string",
      "format": "date"
    },
    "batch_number": {
      "type": "string"
    },
    "restock_reminder_days": {
      "type": "number",
      "default": 7
    },
    "notes": {
      "type": "string"
    },
    "photo_url": {
      "type": "string",
      "description": "Foto barang"
    },
    "sku": {
      "type": "string",
      "description": "Kode SKU unik, prefix OBT/VIT/ALT/LNN-XXXX"
    },
    "last_edited_by": {
      "type": "string",
      "description": "Email user terakhir edit"
    },
    "last_edited_at": {
      "type": "string",
      "format": "date-time",
      "description": "Waktu terakhir edit"
    }
  },
  "required": [
    "name",
    "unit",
    "current_stock",
    "minimum_stock",
    "category",
    "purchase_price"
  ]
}