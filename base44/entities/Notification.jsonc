{
  "name": "Notification",
  "type": "object",
  "properties": {
    "recipient_email": {
      "type": "string",
      "description": "Email penerima notifikasi"
    },
    "recipient_role": {
      "type": "string",
      "enum": [
        "owner",
        "manajer",
        "admin",
        "kepala_feeder",
        "keeper",
        "investor",
        "semua"
      ],
      "description": "Role penerima"
    },
    "title": {
      "type": "string",
      "description": "Judul notifikasi"
    },
    "message": {
      "type": "string",
      "description": "Isi pesan notifikasi"
    },
    "type": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "alert",
        "success"
      ],
      "default": "info"
    },
    "priority": {
      "type": "string",
      "enum": [
        "tinggi",
        "sedang",
        "rendah"
      ],
      "default": "sedang",
      "description": "Prioritas notifikasi"
    },
    "category": {
      "type": "string",
      "enum": [
        "stok",
        "kesehatan",
        "breeding",
        "keuangan",
        "absensi",
        "sistem",
        "lainnya"
      ]
    },
    "is_read": {
      "type": "boolean",
      "default": false
    },
    "is_dismissed": {
      "type": "boolean",
      "default": false,
      "description": "Apakah notifikasi sudah di-dismiss"
    },
    "read_at": {
      "type": "string",
      "format": "date-time",
      "description": "Waktu dibaca"
    },
    "scheduled_at": {
      "type": "string",
      "format": "date-time",
      "description": "Untuk notifikasi terjadwal masa depan"
    },
    "action_url": {
      "type": "string",
      "description": "Link halaman terkait"
    },
    "action_label": {
      "type": "string",
      "description": "Label tombol aksi"
    },
    "related_entity_id": {
      "type": "string",
      "description": "ID entity terkait untuk anti-duplikat"
    },
    "related_entity_type": {
      "type": "string",
      "description": "Tipe entity terkait (HealthRecord, StockMovement, dll)"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Waktu notifikasi dibuat"
    }
  },
  "required": [
    "recipient_email",
    "title",
    "message"
  ]
}