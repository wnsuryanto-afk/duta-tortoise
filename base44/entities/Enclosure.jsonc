{
  "name": "Enclosure",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "indoor",
        "outdoor",
        "greenhouse"
      ],
      "default": "indoor"
    },
    "size_m2": {
      "type": "number"
    },
    "max_capacity": {
      "type": "number"
    },
    "current_count": {
      "type": "number",
      "default": 0
    },
    "ideal_temp_min": {
      "type": "number"
    },
    "ideal_temp_max": {
      "type": "number"
    },
    "ideal_humidity": {
      "type": "number"
    },
    "location": {
      "type": "string"
    },
    "photo_url": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "type",
    "max_capacity"
  ]
}