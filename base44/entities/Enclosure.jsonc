{
  "name": "Enclosure",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "indoor",
        "outdoor",
        "greenhouse"
      ],
      "default": "indoor"
    },
    "size_m2": {
      "type": "number"
    },
    "max_capacity": {
      "type": "number"
    },
    "current_count": {
      "type": "number",
      "default": 0
    },
    "ideal_temp_min": {
      "type": "number"
    },
    "ideal_temp_max": {
      "type": "number"
    },
    "ideal_humidity": {
      "type": "number"
    },
    "location": {
      "type": "string"
    },
    "photo_url": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "notes": {
      "type": "string"
    },
    "is_archived": {
      "type": "boolean",
      "default": false,
      "description": "Apakah data sudah diarsipkan"
    },
    "ronda_harian": {
      "type": "boolean",
      "description": "Apakah kandang ini termasuk ronda harian kiper - satu ubin di layar Hari Ini, dengan poin pakan + cek kesehatan dan pembersihan. Sebelum field ini ada, daftarnya ditulis mati di src/lib/kandang.js, sehingga menggabungkan N1-N3 menjadi N membuat 28 kura hilang dari ronda sampai kodenya diubah dan dibangun ulang. Kosong berarti ikut daftar lama itu sebagai cadangan."
    }
  },
  "required": [
    "name",
    "type",
    "max_capacity"
  ]
}
