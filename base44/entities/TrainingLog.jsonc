{
  "name": "TrainingLog",
  "type": "object",
  "properties": {
    "employee_id": {
      "type": "string"
    },
    "employee_name": {
      "type": "string"
    },
    "employee_email": {
      "type": "string"
    },
    "training_title": {
      "type": "string"
    },
    "training_date": {
      "type": "string",
      "format": "date"
    },
    "duration_hours": {
      "type": "number"
    },
    "trainer": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "perawatan",
        "breeding",
        "kesehatan",
        "administrasi",
        "lainnya"
      ],
      "default": "lainnya"
    },
    "result": {
      "type": "string",
      "enum": [
        "lulus",
        "tidak_lulus",
        "dalam_proses"
      ],
      "default": "dalam_proses"
    },
    "certificate_url": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "employee_name",
    "employee_email",
    "training_title",
    "training_date",
    "category"
  ]
}