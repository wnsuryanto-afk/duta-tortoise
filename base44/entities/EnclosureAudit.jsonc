{
  "name": "EnclosureAudit",
  "type": "object",
  "properties": {
    "enclosure_id": {
      "type": "string"
    },
    "enclosure_name": {
      "type": "string",
      "description": "Nama kandang"
    },
    "audit_date": {
      "type": "string",
      "format": "date",
      "description": "Tanggal audit"
    },
    "auditor_name": {
      "type": "string",
      "description": "Nama auditor"
    },
    "checklist": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "aspect": {
            "type": "string"
          },
          "score": {
            "type": "number"
          },
          "notes": {
            "type": "string"
          }
        }
      },
      "description": "Checklist aspek penilaian (skor 1-5)"
    },
    "total_score": {
      "type": "number",
      "description": "Total skor otomatis"
    },
    "grade": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "D"
      ],
      "description": "Grade otomatis dari skor"
    },
    "photo_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "action_items": {
      "type": "string",
      "description": "Tindakan perbaikan yang perlu dilakukan"
    },
    "follow_up_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "enclosure_name",
    "audit_date",
    "auditor_name"
  ]
}