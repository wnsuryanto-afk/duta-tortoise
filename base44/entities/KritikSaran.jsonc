{
  "name": "KritikSaran",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Judul singkat saran/kritik"
    },
    "description": {
      "type": "string",
      "description": "Isi kritik/saran detail"
    },
    "type": {
      "type": "string",
      "enum": [
        "kritik",
        "saran",
        "ide_inovasi",
        "keluhan"
      ],
      "default": "saran",
      "description": "Tipe masukan"
    },
    "category": {
      "type": "string",
      "enum": [
        "operasional",
        "fasilitas",
        "manajemen",
        "kesehatan_hewan",
        "keuangan",
        "sdm",
        "teknologi",
        "kebersihan",
        "keamanan",
        "lainnya"
      ],
      "default": "lainnya"
    },
    "priority": {
      "type": "string",
      "enum": [
        "rendah",
        "sedang",
        "tinggi",
        "mendesak"
      ],
      "default": "sedang"
    },
    "submitted_by_email": {
      "type": "string"
    },
    "submitted_by_name": {
      "type": "string"
    },
    "submitted_by_role": {
      "type": "string"
    },
    "is_anonymous": {
      "type": "boolean",
      "default": false
    },
    "submit_date": {
      "type": "string",
      "format": "date-time"
    },
    "attachment_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "dipertimbangkan",
        "diterima",
        "ditolak",
        "sudah_diimplementasi",
        "ditunda"
      ],
      "default": "pending"
    },
    "reviewed_by": {
      "type": "string"
    },
    "reviewed_date": {
      "type": "string",
      "format": "date"
    },
    "review_notes": {
      "type": "string"
    },
    "points_awarded": {
      "type": "number",
      "default": 0
    },
    "implementation_date": {
      "type": "string",
      "format": "date"
    },
    "implementation_notes": {
      "type": "string"
    },
    "upvotes": {
      "type": "number",
      "default": 0
    },
    "upvoted_by": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Email yang sudah upvote"
    }
  },
  "required": [
    "title",
    "description",
    "type",
    "submitted_by_email",
    "submitted_by_name",
    "submit_date"
  ]
}