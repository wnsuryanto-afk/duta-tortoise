{
  "name": "SOPTask",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Nama task SOP"
    },
    "description": {
      "type": "string",
      "description": "Deskripsi task"
    },
    "category": {
      "type": "string",
      "enum": [
        "pakan",
        "kebersihan",
        "pemeriksaan",
        "breeding",
        "administrasi",
        "suplemen",
        "lainnya"
      ],
      "default": "lainnya",
      "description": "Kategori task"
    },
    "points": {
      "type": "number",
      "default": 10,
      "description": "Poin per task selesai"
    },
    "frequency": {
      "type": "string",
      "enum": [
        "harian",
        "mingguan",
        "bulanan"
      ],
      "default": "harian",
      "description": "Frekuensi task"
    },
    "weekly_days": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Hari dalam seminggu untuk task mingguan (0=Minggu, 1=Senin,...6=Sabtu)"
    },
    "monthly_dates": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Tanggal-tanggal dalam bulan untuk task bulanan (1-31)"
    },
    "target_enclosures": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Kandang yang dituju (kosong = semua)"
    },
    "target_tortoise_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "ID kura-kura yang dituju (kosong = semua)"
    },
    "target_tortoise_names": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Nama kura-kura yang dituju"
    },
    "deadline_time": {
      "type": "string",
      "description": "Batas waktu pengerjaan (HH:mm)"
    },
    "require_photo": {
      "type": "boolean",
      "default": false,
      "description": "Apakah task wajib disertai foto bukti"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Task aktif atau tidak"
    }
  },
  "required": [
    "title",
    "points"
  ]
}