{
  "name": "SOPTask",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Nama task SOP"
    },
    "description": {
      "type": "string",
      "description": "Deskripsi task"
    },
    "category": {
      "type": "string",
      "enum": [
        "pakan",
        "kebersihan",
        "pemeriksaan",
        "breeding",
        "administrasi",
        "suplemen",
        "perawatan",
        "lainnya"
      ],
      "default": "lainnya",
      "description": "Kategori task"
    },
    "points": {
      "type": "number",
      "default": 10,
      "description": "Poin per task selesai"
    },
    "frequency": {
      "type": "string",
      "enum": [
        "harian",
        "mingguan",
        "bulanan"
      ],
      "default": "harian",
      "description": "Frekuensi task"
    },
    "weekly_days": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Hari dalam seminggu untuk task mingguan (0=Minggu, 1=Senin,...6=Sabtu)"
    },
    "monthly_dates": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Tanggal-tanggal dalam bulan untuk task bulanan (1-31)"
    },
    "bulan_aktif": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Bulan berapa saja task ini berlaku (1=Januari ... 12=Desember). Kosong = berlaku sepanjang tahun. Dipakai untuk pekerjaan yang jadwalnya lebih jarang daripada bulanan (mis. tiap 2 bulan pada bulan ganjil) atau musiman."
    },
    "target_enclosures": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Kandang yang dituju (kosong = semua)"
    },
    "target_tortoise_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "ID kura-kura yang dituju (kosong = semua)"
    },
    "target_tortoise_names": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Nama kura-kura yang dituju"
    },
    "deadline_time": {
      "type": "string",
      "description": "Batas waktu pengerjaan (HH:mm)"
    },
    "require_photo": {
      "type": "boolean",
      "default": false,
      "description": "Apakah task wajib disertai foto bukti"
    },
    "ai_check_points": {
      "type": "string",
      "description": "Daftar hal yang diperiksa AI pada foto task ini (panduan per task). Kosong = penilaian umum."
    },
    "boleh_carryover": {
      "type": "boolean",
      "default": false,
      "description": "Apakah task boleh dibawa tertunggak (carry-over) ke hari berikutnya"
    },
    "jenis_carryover": {
      "type": "string",
      "enum": [
        "1hari",
        "tertunggak",
        "hangus"
      ],
      "default": "1hari",
      "description": "Jenis carry-over: 1hari = boleh dibawa 1 hari, tertunggak = boleh menumpuk, hangus = batal jika tidak dikerjakan"
    },
    "butuh_bahan_gudang": {
      "type": "boolean",
      "default": false,
      "description": "Apakah task butuh bahan dari gudang (cek stok sebelum dikerjakan)"
    },
    "wajib_untuk_role": {
      "type": "string",
      "enum": [
        "semua",
        "keeper",
        "kepala_feeder",
        "admin",
        "manajer",
        "owner"
      ],
      "default": "semua",
      "description": "Role yang wajib mengerjakan task ini (semua = siapa saja)"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Task aktif atau tidak"
    },
    "task_scope": {
      "type": "string",
      "enum": [
        "bersama",
        "pribadi",
        "per_kandang",
        "per_kura"
      ],
      "default": "bersama",
      "description": "Scope penguncian: bersama = sekali untuk semua orang, pribadi = masing-masing karyawan, per_kandang = per kandang (perlu target_enclosures), per_kura = per kura-kura (perlu target_tortoise_ids)"
    },
    "assigned_to_email": {
      "type": "string",
      "description": "Email karyawan khusus (kosong = siapa saja)"
    },
    "assigned_to_name": {
      "type": "string",
      "description": "Nama karyawan khusus"
    },
    "required_skus": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "SKU item gudang yang dibutuhkan (untuk cek stok)"
    },
    "pakan_terpakai": {
      "type": "array",
      "description": "A6 \u2014 Bahan yang habis terpakai setiap kali task ini dikerjakan. Diisi sekali, lalu stok berkurang sendiri saat task dicentang, sehingga tidak perlu lagi pencatatan pakan manual.",
      "items": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string",
            "description": "SKU bahan (PKN-xxxx untuk stok pakan, SKU gudang untuk obat/suplemen)"
          },
          "nama": {
            "type": "string",
            "description": "Nama bahan, untuk dibaca manusia"
          },
          "jumlah": {
            "type": "number",
            "description": "Jumlah terpakai sekali kerja, dalam satuan bahan tersebut"
          },
          "sumber": {
            "type": "string",
            "enum": [
              "pakan",
              "gudang"
            ],
            "default": "pakan",
            "description": "Diambil dari Stok Pakan atau dari Gudang"
          }
        }
      }
    },
    "terkunci_bahan": {
      "type": "boolean",
      "default": false,
      "description": "A9 \u2014 Diisi otomatis: true bila bahan yang dibutuhkan task ini habis, sehingga task tidak bisa dikerjakan hari ini."
    },
    "di_ubin_kandang": {
      "type": "boolean",
      "default": false,
      "description": "D12: dikerjakan lewat ubin kandang di layar kiper, bukan sebagai baris tersendiri. Satu ketukan pada satu kandang menyelesaikan SEMUA task bertanda ini sekaligus, dan poinnya dijumlahkan. Dipakai karena kiper memang mendatangi tiap kandang satu kali: membersihkan, memberi pakan, dan mengecek kesehatan dalam kunjungan yang sama. Ditandai lewat kolom ini, bukan lewat pencocokan judul, supaya mengganti nama task tidak diam-diam mematikan poinnya."
    },
    "terkunci_alasan": {
      "type": "string",
      "description": "A9 \u2014 Bahan apa yang habis, untuk ditampilkan ke keeper."
    }
  },
  "required": [
    "title",
    "points"
  ]
}