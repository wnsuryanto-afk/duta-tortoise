{
  "name": "MaintenanceLog",
  "type": "object",
  "properties": {
    "check_key": {
      "type": "string",
      "description": "Unique key: enclosure_id__freq__item_id__period_key"
    },
    "enclosure_id": {
      "type": "string",
      "description": "ID kandang"
    },
    "enclosure_name": {
      "type": "string",
      "description": "Nama kandang"
    },
    "freq": {
      "type": "string",
      "enum": [
        "harian",
        "mingguan",
        "bulanan"
      ],
      "description": "Frekuensi checklist"
    },
    "item_id": {
      "type": "string",
      "description": "ID item checklist"
    },
    "item_label": {
      "type": "string",
      "description": "Label item checklist"
    },
    "period_key": {
      "type": "string",
      "description": "Kunci periode (YYYY-MM-DD)"
    },
    "is_done": {
      "type": "boolean",
      "default": false
    },
    "done_at": {
      "type": "string",
      "description": "Jam selesai (HH:mm)"
    },
    "done_by": {
      "type": "string",
      "description": "Nama keeper yang mencentang"
    },
    "done_by_email": {
      "type": "string",
      "description": "Email keeper"
    },
    "is_verified": {
      "type": "boolean",
      "default": false
    },
    "verified_by": {
      "type": "string"
    },
    "verified_at": {
      "type": "string"
    },
    "poin_earned": {
      "type": "number",
      "default": 0
    },
    "notes": {
      "type": "string"
    },
    "photo_url": {
      "type": "string",
      "description": "URL foto dokumentasi kegiatan"
    },
    "is_extra": {
      "type": "boolean",
      "default": false,
      "description": "Tugas tambahan di luar SOP"
    },
    "extra_description": {
      "type": "string",
      "description": "Deskripsi tugas tambahan"
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "description": "Status approval tugas tambahan"
    },
    "approved_by": {
      "type": "string",
      "description": "Nama yang approve"
    },
    "approved_at": {
      "type": "string",
      "description": "Waktu approve"
    },
    "is_test_data": {
      "type": "boolean",
      "default": false,
      "description": "Ditandai sebagai data test (Mode Uji owner) \u2014 tidak masuk laporan/poin asli"
    },
    "excluded_from_reports": {
      "type": "boolean",
      "default": false,
      "description": "Dikecualikan dari laporan (owner only)"
    }
  },
  "required": [
    "check_key",
    "enclosure_id",
    "enclosure_name",
    "freq",
    "item_id",
    "period_key"
  ]
}