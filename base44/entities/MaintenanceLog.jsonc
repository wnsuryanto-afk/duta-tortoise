{
  "name": "MaintenanceLog",
  "type": "object",
  "properties": {
    "check_key": {
      "type": "string",
      "description": "Unique key: enclosure_id__freq__item_id__period_key"
    },
    "enclosure_id": {
      "type": "string",
      "description": "ID kandang"
    },
    "enclosure_name": {
      "type": "string",
      "description": "Nama kandang"
    },
    "freq": {
      "type": "string",
      "enum": [
        "harian",
        "mingguan",
        "bulanan"
      ],
      "description": "Frekuensi checklist"
    },
    "item_id": {
      "type": "string",
      "description": "ID item checklist (d1, d2, w1, m1, etc.)"
    },
    "item_label": {
      "type": "string",
      "description": "Label item checklist"
    },
    "period_key": {
      "type": "string",
      "description": "Kunci periode (YYYY-MM-DD untuk harian, YYYY-MM-Wn untuk mingguan, YYYY-MM untuk bulanan)"
    },
    "is_done": {
      "type": "boolean",
      "default": false,
      "description": "Sudah dicentang oleh keeper"
    },
    "done_at": {
      "type": "string",
      "description": "Jam selesai (HH:mm)"
    },
    "done_by": {
      "type": "string",
      "description": "Nama keeper yang mencentang"
    },
    "is_verified": {
      "type": "boolean",
      "default": false,
      "description": "Sudah diverifikasi oleh kepala feeder"
    },
    "verified_by": {
      "type": "string",
      "description": "Nama kepala feeder yang verifikasi"
    },
    "verified_at": {
      "type": "string",
      "description": "Jam verifikasi (HH:mm)"
    },
    "notes": {
      "type": "string",
      "description": "Catatan tambahan"
    }
  },
  "required": [
    "check_key",
    "enclosure_id",
    "enclosure_name",
    "freq",
    "item_id",
    "period_key"
  ]
}