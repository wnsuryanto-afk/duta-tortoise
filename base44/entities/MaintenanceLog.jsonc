{
  "name": "MaintenanceLog",
  "type": "object",
  "properties": {
    "schedule_id": {
      "type": "string",
      "description": "ID jadwal perawatan"
    },
    "enclosure_name": {
      "type": "string",
      "description": "Nama kandang"
    },
    "task_type": {
      "type": "string",
      "enum": [
        "pakan",
        "kebersihan_harian",
        "kebersihan_mingguan",
        "kebersihan_bulanan"
      ],
      "description": "Jenis perawatan"
    },
    "done_date": {
      "type": "string",
      "format": "date",
      "description": "Tanggal pelaksanaan"
    },
    "done_by": {
      "type": "string",
      "description": "Dilakukan oleh"
    },
    "tasks_completed": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tugas yang diselesaikan"
    },
    "duration_minutes": {
      "type": "number",
      "description": "Durasi (menit)"
    },
    "photo_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Foto dokumentasi"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "enclosure_name",
    "task_type",
    "done_date",
    "done_by"
  ]
}