{
  "name": "OnboardingChecklist",
  "type": "object",
  "properties": {
    "employee_id": {
      "type": "string"
    },
    "employee_name": {
      "type": "string",
      "description": "Nama karyawan"
    },
    "employee_email": {
      "type": "string",
      "description": "Email karyawan"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Tanggal mulai kerja"
    },
    "phase": {
      "type": "string",
      "enum": [
        "hari_1",
        "minggu_1",
        "bulan_1"
      ],
      "default": "hari_1"
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "task_title": {
            "type": "string"
          },
          "sop_id": {
            "type": "string"
          },
          "is_completed": {
            "type": "boolean",
            "default": false
          },
          "completed_date": {
            "type": "string",
            "format": "date"
          },
          "verified_by": {
            "type": "string"
          }
        }
      }
    },
    "overall_progress": {
      "type": "number",
      "default": 0,
      "description": "Persentase progres keseluruhan"
    },
    "status": {
      "type": "string",
      "enum": [
        "berjalan",
        "selesai",
        "terhenti"
      ],
      "default": "berjalan"
    }
  },
  "required": [
    "employee_name",
    "employee_email"
  ]
}