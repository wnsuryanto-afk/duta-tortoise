{
  "name": "FeedStock",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "sayuran",
        "buah",
        "rumput",
        "suplemen",
        "pelet",
        "hay",
        "lainnya"
      ],
      "default": "sayuran"
    },
    "unit": {
      "type": "string",
      "enum": [
        "kg",
        "gram",
        "ikat",
        "buah",
        "liter",
        "keranjang",
        "karung"
      ],
      "default": "kg"
    },
    "current_stock": {
      "type": "number",
      "default": 0
    },
    "minimum_stock": {
      "type": "number",
      "default": 1
    },
    "price_per_unit": {
      "type": "number",
      "default": 0
    },
    "daily_ideal": {
      "type": "number",
      "default": 0
    },
    "supplier": {
      "type": "string"
    },
    "last_restocked_date": {
      "type": "string",
      "format": "date"
    },
    "last_restocked_qty": {
      "type": "number"
    },
    "is_mandatory": {
      "type": "boolean",
      "default": false,
      "description": "Apakah pakan ini wajib tersedia"
    },
    "sumber_sendiri": {
      "type": "boolean",
      "default": false,
      "description": "Pakan ini dipanen/dicari sendiri, bukan dibeli. Pemakaiannya tetap dihitung, tetapi TIDAK pernah masuk daftar belanja otomatis \u2014 tanpa penanda ini, rumput yang dipotong sendiri tiap hari akan muncul sebagai pesanan beli berton-ton."
    },
    "sumber_pakan": {
      "type": "string",
      "enum": [
        "beli",
        "sendiri",
        "campuran",
        "insidentil"
      ],
      "default": "beli",
      "description": "Dari mana pakan ini datang, dan karena itu bagaimana daftar belanja otomatis memperlakukannya. beli = selalu dibeli, masuk daftar begitu sisa hari menipis, dibelanjakan untuk dua pekan. sendiri = selalu dipanen/dicari sendiri, pemakaian tetap dihitung tetapi tidak pernah dibeli. campuran = dicari sendiri lebih dulu, dibeli hanya bila kurang (saat stok menyentuh batas minimum) dan secukupnya 5 hari. insidentil = hanya dipakai saat kebetulan ada, tidak pernah dibeli otomatis dan tidak pernah memicu peringatan habis."
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Bahan ini masih dilacak sebagai stok. Dimatikan untuk bahan yang memang tidak dicatat masuk-keluarnya - mis. rumput dan kaktus dari kebun sendiri. Bahan nonaktif TIDAK memicu peringatan stok, tidak masuk daftar belanja otomatis, dan tidak dipotong saat SOP dicentang; datanya tetap utuh (termasuk daily_ideal) supaya bisa dihidupkan lagi kapan saja tanpa mengetik ulang. Sejak 16 Nov 2026 kolom ini juga menentukan pilihan jenis pakan di formulir Pakan Harian: hanya bahan aktif yang bisa dipilih."
    },
    "storage_location": {
      "type": "string",
      "enum": [
        "gudang",
        "gazebo"
      ],
      "default": "gudang",
      "description": "Lokasi penyimpanan"
    },
    "conversion_notes": {
      "type": "string",
      "description": "Catatan konversi"
    },
    "notes": {
      "type": "string"
    },
    "photo_url": {
      "type": "string",
      "description": "Foto barang"
    },
    "sku": {
      "type": "string",
      "description": "Kode SKU unik, prefix PKN-XXXX"
    },
    "last_edited_by": {
      "type": "string",
      "description": "Email user terakhir edit"
    },
    "last_edited_at": {
      "type": "string",
      "format": "date-time",
      "description": "Waktu terakhir edit"
    },
    "kelas_pakan": {
      "type": "string",
      "enum": [
        "hijauan_utama",
        "serat_kering",
        "kaktus",
        "daun_herba",
        "buah_manis",
        "pelet",
        "suplemen"
      ],
      "description": "Golongan pakan, dipakai menghitung porsi hijauan di widget Pakan Harian: hijauan_utama + kaktus + daun_herba dihitung sebagai hijauan, sisanya tidak. Kosong berarti belum digolongkan \u2014 bahan seperti itu tidak dihitung sebagai hijauan, bukan dianggap hijauan."
    },
    "dm_percent": {
      "type": "number",
      "description": "Bahan kering (% dari berat segar). OPSIONAL \u2014 kosongkan bila bahan belum diuji lab. Jangan menebak angkanya: angka kosong lebih jujur daripada angka karangan, dan hanya dipakai sebagai rujukan, bukan untuk perhitungan stok."
    },
    "cf_percent": {
      "type": "number",
      "description": "Serat kasar / crude fiber (%). OPSIONAL, kosongkan bila belum diuji lab."
    },
    "cp_percent": {
      "type": "number",
      "description": "Protein kasar / crude protein (%). OPSIONAL, kosongkan bila belum diuji lab."
    },
    "ca_percent": {
      "type": "number",
      "description": "Kalsium (%). OPSIONAL, kosongkan bila belum diuji lab."
    },
    "p_percent": {
      "type": "number",
      "description": "Fosfor (%). OPSIONAL, kosongkan bila belum diuji lab."
    }
  },
  "required": [
    "name",
    "unit",
    "current_stock",
    "minimum_stock",
    "category",
    "price_per_unit"
  ]
}