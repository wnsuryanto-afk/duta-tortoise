{
  "name": "FeedStock",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nama pakan (cth: Kubis, Wortel, Rumput)"
    },
    "category": {
      "type": "string",
      "enum": [
        "sayuran",
        "buah",
        "rumput",
        "suplemen",
        "lainnya"
      ],
      "default": "sayuran",
      "description": "Kategori pakan"
    },
    "unit": {
      "type": "string",
      "enum": [
        "kg",
        "gram",
        "ikat",
        "buah",
        "liter"
      ],
      "default": "kg",
      "description": "Satuan"
    },
    "current_stock": {
      "type": "number",
      "default": 0,
      "description": "Stok saat ini"
    },
    "minimum_stock": {
      "type": "number",
      "default": 1,
      "description": "Batas minimum stok (notifikasi akan muncul di bawah angka ini)"
    },
    "price_per_unit": {
      "type": "number",
      "default": 0,
      "description": "Harga per satuan (Rp)"
    },
    "daily_ideal": {
      "type": "number",
      "default": 0,
      "description": "Kebutuhan harian ideal (dalam satuan)"
    },
    "supplier": {
      "type": "string",
      "description": "Nama supplier / toko pakan"
    },
    "last_restocked_date": {
      "type": "string",
      "format": "date",
      "description": "Tanggal terakhir restock"
    },
    "last_restocked_qty": {
      "type": "number",
      "description": "Jumlah terakhir restock"
    },
    "notes": {
      "type": "string",
      "description": "Catatan"
    }
  },
  "required": [
    "name",
    "unit",
    "current_stock",
    "minimum_stock"
  ]
}