{
  "name": "FeedStock",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "sayuran",
        "buah",
        "rumput",
        "suplemen",
        "lainnya"
      ],
      "default": "sayuran"
    },
    "unit": {
      "type": "string",
      "enum": [
        "kg",
        "gram",
        "ikat",
        "buah",
        "liter"
      ],
      "default": "kg"
    },
    "current_stock": {
      "type": "number",
      "default": 0
    },
    "minimum_stock": {
      "type": "number",
      "default": 1
    },
    "price_per_unit": {
      "type": "number",
      "default": 0
    },
    "daily_ideal": {
      "type": "number",
      "default": 0
    },
    "supplier": {
      "type": "string"
    },
    "last_restocked_date": {
      "type": "string",
      "format": "date"
    },
    "last_restocked_qty": {
      "type": "number"
    },
    "is_mandatory": {
      "type": "boolean",
      "default": false,
      "description": "Apakah pakan ini wajib tersedia"
    },
    "storage_location": {
      "type": "string",
      "enum": [
        "gudang",
        "gazebo"
      ],
      "default": "gudang",
      "description": "Lokasi penyimpanan"
    },
    "conversion_notes": {
      "type": "string",
      "description": "Catatan konversi, cth: 4 keranjang sayur rempes = 1 rokok"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "unit",
    "current_stock",
    "minimum_stock",
    "category",
    "price_per_unit"
  ]
}