{
  "name": "QuarantineRecord",
  "type": "object",
  "properties": {
    "tortoise_id": {
      "type": "string",
      "description": "ID tortoise yang dikarantina"
    },
    "tortoise_name": {
      "type": "string",
      "description": "Nama tortoise"
    },
    "quarantine_reason": {
      "type": "string",
      "enum": [
        "pendatang_baru",
        "sakit",
        "cedera",
        "observasi",
        "sebelum_dijual",
        "pasca_breeding",
        "lainnya"
      ],
      "description": "Alasan karantina"
    },
    "reason_detail": {
      "type": "string",
      "description": "Detail alasan karantina"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Tanggal mulai karantina"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "Tanggal selesai karantina"
    },
    "expected_duration_days": {
      "type": "number",
      "default": 14,
      "description": "Durasi karantina yang diharapkan (hari)"
    },
    "quarantine_enclosure": {
      "type": "string",
      "description": "Kandang karantina yang digunakan"
    },
    "daily_observations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "observer": {
            "type": "string"
          },
          "temperature": {
            "type": "number"
          },
          "weight": {
            "type": "number"
          },
          "appetite": {
            "type": "string",
            "enum": [
              "normal",
              "kurang",
              "tidak_mau"
            ]
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "treatment_given": {
      "type": "string",
      "description": "Obat/treatment yang diberikan"
    },
    "status": {
      "type": "string",
      "enum": [
        "aktif",
        "selesai",
        "gagal_mati",
        "dibatalkan"
      ],
      "default": "aktif",
      "description": "Status karantina"
    },
    "result": {
      "type": "string",
      "enum": [
        "lulus",
        "perlu_lanjut"
      ],
      "description": "Hasil akhir karantina"
    },
    "released_by": {
      "type": "string",
      "description": "Manajer yang menyatakan lulus"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "tortoise_id",
    "tortoise_name",
    "quarantine_reason",
    "start_date"
  ]
}