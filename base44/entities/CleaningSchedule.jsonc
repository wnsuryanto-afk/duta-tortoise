{
  "name": "CleaningSchedule",
  "type": "object",
  "properties": {
    "enclosure_id": {
      "type": "string",
      "description": "ID kandang"
    },
    "enclosure_name": {
      "type": "string",
      "description": "Nama kandang"
    },
    "cleaning_type": {
      "type": "string",
      "enum": [
        "harian_ringan",
        "mingguan_sedang",
        "bulanan_besar"
      ],
      "description": "Jenis pembersihan"
    },
    "frequency_days": {
      "type": "number",
      "description": "Frekuensi (hari)"
    },
    "last_cleaned": {
      "type": "string",
      "format": "date",
      "description": "Terakhir dibersihkan"
    },
    "next_cleaning_date": {
      "type": "string",
      "format": "date",
      "description": "Jadwal pembersihan berikutnya"
    },
    "assigned_to": {
      "type": "string",
      "description": "Karyawan yang bertanggung jawab"
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Checklist tugas"
    },
    "notes": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "enclosure_id",
    "enclosure_name",
    "cleaning_type"
  ]
}