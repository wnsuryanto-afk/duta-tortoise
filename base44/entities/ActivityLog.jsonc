{
  "name": "ActivityLog",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email user yang melakukan aksi"
    },
    "user_name": {
      "type": "string",
      "description": "Nama user"
    },
    "action": {
      "type": "string",
      "enum": [
        "create",
        "update",
        "delete",
        "login",
        "logout"
      ],
      "description": "Jenis aksi"
    },
    "entity_type": {
      "type": "string",
      "description": "Tipe entity (Tortoise, Sale, Breeding, dll)"
    },
    "entity_id": {
      "type": "string",
      "description": "ID entity yang diubah"
    },
    "entity_name": {
      "type": "string",
      "description": "Nama entity untuk display"
    },
    "changes": {
      "type": "object",
      "description": "Perubahan (before/after) untuk action update"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Waktu aksi"
    },
    "ip_address": {
      "type": "string",
      "description": "IP address (opsional)"
    },
    "notes": {
      "type": "string",
      "description": "Catatan tambahan"
    }
  },
  "required": [
    "user_email",
    "action",
    "entity_type",
    "entity_id",
    "timestamp"
  ]
}