{
  "name": "ActivityLog",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email user yang melakukan aksi"
    },
    "user_name": {
      "type": "string",
      "description": "Nama user"
    },
    "action": {
      "type": "string",
      "enum": [
        "create",
        "update",
        "delete",
        "login",
        "logout"
      ],
      "description": "Jenis aksi"
    },
    "entity_type": {
      "type": "string",
      "description": "Tipe entity (Tortoise, Sale, Breeding, dll)"
    },
    "entity_id": {
      "type": "string",
      "description": "ID entity yang diubah"
    },
    "entity_name": {
      "type": "string",
      "description": "Nama entity untuk display"
    },
    "changes_summary": {
      "type": "string",
      "description": "Ringkasan perubahan yang ramah pengguna"
    },
    "changes_detail": {
      "type": "array",
      "description": "Detail field yang berubah",
      "items": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "old_value": {
            "type": "string"
          },
          "new_value": {
            "type": "string"
          }
        }
      }
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Waktu aksi"
    },
    "notes": {
      "type": "string",
      "description": "Catatan tambahan"
    }
  },
  "required": [
    "user_email",
    "action",
    "entity_type",
    "entity_id",
    "timestamp"
  ]
}