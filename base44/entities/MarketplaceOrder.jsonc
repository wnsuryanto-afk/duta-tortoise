{
  "name": "MarketplaceOrder",
  "type": "object",
  "properties": {
    "order_id": {
      "type": "string"
    },
    "platform": {
      "type": "string",
      "enum": [
        "tokopedia",
        "shopee"
      ]
    },
    "buyer_name": {
      "type": "string"
    },
    "buyer_phone": {
      "type": "string"
    },
    "product_name": {
      "type": "string"
    },
    "quantity": {
      "type": "number"
    },
    "total_price": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "baru",
        "diproses",
        "dikirim",
        "selesai",
        "dibatalkan"
      ],
      "default": "baru"
    },
    "order_date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "platform",
    "buyer_name",
    "product_name",
    "total_price",
    "order_date",
    "quantity"
  ]
}