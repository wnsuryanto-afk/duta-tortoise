{
  "name": "MarketplaceOrder",
  "type": "object",
  "properties": {
    "order_id": {
      "type": "string",
      "description": "ID pesanan dari platform"
    },
    "platform": {
      "type": "string",
      "enum": [
        "tokopedia",
        "shopee"
      ]
    },
    "buyer_name": {
      "type": "string",
      "description": "Nama pembeli"
    },
    "buyer_phone": {
      "type": "string",
      "description": "Nomor telepon pembeli"
    },
    "product_name": {
      "type": "string",
      "description": "Nama produk yang dibeli"
    },
    "quantity": {
      "type": "number",
      "description": "Jumlah item"
    },
    "total_price": {
      "type": "number",
      "description": "Total harga (Rp)"
    },
    "status": {
      "type": "string",
      "enum": [
        "baru",
        "diproses",
        "dikirim",
        "selesai",
        "dibatalkan"
      ],
      "default": "baru"
    },
    "order_date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "platform",
    "buyer_name",
    "product_name"
  ]
}