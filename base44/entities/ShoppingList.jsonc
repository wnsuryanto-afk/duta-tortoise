{
  "name": "ShoppingList",
  "type": "object",
  "properties": {
    "nama_barang": {
      "type": "string",
      "description": "Nama barang yang perlu dibeli"
    },
    "jumlah": {
      "type": "number",
      "description": "Jumlah yang perlu dibeli"
    },
    "satuan": {
      "type": "string",
      "description": "Satuan (pcs, botol, kg, dll)"
    },
    "platform_beli": {
      "type": "string",
      "enum": [
        "Tokopedia",
        "Shopee",
        "Apotek",
        "Toko Hewan",
        "Langsung",
        "Lainnya"
      ],
      "description": "Platform/tempat pembelian"
    },
    "harga_est_per_unit": {
      "type": "number",
      "default": 0,
      "description": "Estimasi harga per unit (Rp)"
    },
    "total_est": {
      "type": "number",
      "default": 0,
      "description": "Total estimasi harga (Rp)"
    },
    "priority": {
      "type": "string",
      "enum": [
        "segera",
        "minggu_ini",
        "bulan_ini",
        "opsional"
      ],
      "default": "minggu_ini",
      "description": "Prioritas pembelian"
    },
    "status": {
      "type": "string",
      "enum": [
        "belum_dibeli",
        "sudah_dipesan",
        "sudah_dibeli"
      ],
      "default": "belum_dibeli",
      "description": "Status pembelian"
    },
    "qty_aktual": {
      "type": "number",
      "description": "Jumlah aktual yang dibeli"
    },
    "harga_aktual": {
      "type": "number",
      "description": "Harga aktual total yang dibeli (Rp)"
    },
    "tanggal_dibeli": {
      "type": "string",
      "format": "date",
      "description": "Tanggal dibeli"
    },
    "link_produk": {
      "type": "string",
      "description": "URL link produk (opsional)"
    },
    "warehouse_item_id": {
      "type": "string",
      "description": "Barang gudang yang dimaksud, bila baris ini memang merujuk barang yang sudah terdaftar. Dipakai penerimaan barang untuk mencocokkan tanpa menebak dari nama."
    },
    "item_sku": {
      "type": "string",
      "description": "SKU barang gudang. Sudah ditulis sejak lama dan dibaca saat penerimaan barang, tetapi field-nya belum pernah ada sehingga pencocokan SKU tidak pernah berhasil."
    },
    "pembelian_id": {
      "type": "string",
      "description": "Pesanan (PembelianBarang) yang sedang memproses baris ini. Dikosongkan lagi bila pesanannya dibatalkan."
    },
    "qty_kurang": {
      "type": "number",
      "description": "Sisa yang tidak ikut datang dan dikembalikan ke daftar belanja."
    },
    "tanggal_diterima": {
      "type": "string",
      "format": "date",
      "description": "Tanggal barang benar-benar diterima."
    },
    "notes": {
      "type": "string",
      "description": "Catatan tambahan"
    }
  },
  "required": [
    "nama_barang",
    "jumlah",
    "satuan",
    "priority"
  ]
}