{
  "name": "Attendance",
  "type": "object",
  "properties": {
    "employee_id": {
      "type": "string"
    },
    "employee_name": {
      "type": "string"
    },
    "employee_email": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "check_in": {
      "type": "string"
    },
    "check_out": {
      "type": "string"
    },
    "late_minutes": {
      "type": "number",
      "default": 0
    },
    "overtime_hours": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "hadir",
        "izin",
        "sakit"
      ],
      "default": "hadir"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "employee_name",
    "employee_email",
    "date",
    "check_in",
    "status"
  ]
}