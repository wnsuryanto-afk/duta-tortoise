{
  "name": "Attendance",
  "type": "object",
  "properties": {
    "employee_id": {
      "type": "string"
    },
    "employee_name": {
      "type": "string"
    },
    "employee_email": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "check_in": {
      "type": "string"
    },
    "check_out": {
      "type": "string"
    },
    "check_in_lat": {
      "type": "number",
      "description": "Latitude saat check in"
    },
    "check_in_lng": {
      "type": "number",
      "description": "Longitude saat check in"
    },
    "check_out_lat": {
      "type": "number",
      "description": "Latitude saat check out"
    },
    "check_out_lng": {
      "type": "number",
      "description": "Longitude saat check out"
    },
    "selfie_checkin_url": {
      "type": "string",
      "description": "URL foto selfie saat check in"
    },
    "selfie_checkout_url": {
      "type": "string",
      "description": "URL foto selfie saat check out"
    },
    "checkout_location_verified": {
      "type": "boolean",
      "description": "Apakah lokasi saat pulang ada di dalam area. Pasangan dari location_verified yang mencatat lokasi saat datang; sudah ditulis dua layar tetapi field-nya belum pernah ada."
    },
    "location_verified": {
      "type": "boolean",
      "default": false,
      "description": "Apakah lokasi terverifikasi dalam radius kandang"
    },
    "late_minutes": {
      "type": "number",
      "default": 0,
      "description": "Menit setelah jam mulai shift. Sudah ada sejak awal tetapi bernilai 0 di seluruh 117 baris yang pernah tercatat \u2014 satu-satunya yang pernah mengisinya adalah fungsi server autoAttendance, dan fungsi itu belum pernah membuat satu baris pun. Sejak sekarang diisi juga oleh tombol check-in."
    },
    "late_reason": {
      "type": "string",
      "enum": [
        "cari_rumput",
        "tugas_luar",
        "terlambat"
      ],
      "description": "Alasan jam masuk melewati ambang (satu jam). cari_rumput dan tugas_luar adalah PEKERJAAN, bukan kelalaian; keduanya tidak menambah maupun mengurangi upah \u2014 hanya menerangkan jam masuknya. Kosong pada baris lama, karena aplikasi memang belum pernah menanyakannya."
    },
    "late_note": {
      "type": "string",
      "description": "Keterangan yang ditulis sendiri oleh yang bersangkutan. Wajib untuk tugas_luar dan terlambat."
    },
    "late_photo_url": {
      "type": "string",
      "description": "Foto bukti, wajib untuk cari_rumput. Rumput adalah barang yang bisa difoto; ban bocor tidak, karena itu alasan lain hanya menuntut keterangan tertulis."
    },
    "overtime_hours": {
      "type": "number",
      "default": 0
    },
    "shift_start": {
      "type": "string",
      "description": "Jam mulai shift (HH:mm)"
    },
    "shift_end": {
      "type": "string",
      "description": "Jam selesai shift (HH:mm)"
    },
    "status": {
      "type": "string",
      "enum": [
        "hadir",
        "izin",
        "sakit"
      ],
      "default": "hadir"
    },
    "notes": {
      "type": "string"
    },
    "excluded_from_reports": {
      "type": "boolean",
      "default": false,
      "description": "Dikecualikan dari laporan (owner only)"
    },
    "is_test_data": {
      "type": "boolean",
      "default": false,
      "description": "Ditandai sebagai data test \u2014 tidak masuk laporan"
    }
  },
  "required": [
    "employee_name",
    "employee_email",
    "date",
    "check_in",
    "status"
  ]
}