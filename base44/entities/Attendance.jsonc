{
  "name": "Attendance",
  "type": "object",
  "properties": {
    "employee_id": {
      "type": "string"
    },
    "employee_name": {
      "type": "string"
    },
    "employee_email": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "check_in": {
      "type": "string"
    },
    "check_out": {
      "type": "string"
    },
    "check_in_lat": {
      "type": "number",
      "description": "Latitude saat check in"
    },
    "check_in_lng": {
      "type": "number",
      "description": "Longitude saat check in"
    },
    "check_out_lat": {
      "type": "number",
      "description": "Latitude saat check out"
    },
    "check_out_lng": {
      "type": "number",
      "description": "Longitude saat check out"
    },
    "location_verified": {
      "type": "boolean",
      "default": false,
      "description": "Apakah lokasi terverifikasi dalam radius kandang"
    },
    "late_minutes": {
      "type": "number",
      "default": 0
    },
    "overtime_hours": {
      "type": "number",
      "default": 0
    },
    "shift_start": {
      "type": "string",
      "description": "Jam mulai shift (HH:mm)"
    },
    "shift_end": {
      "type": "string",
      "description": "Jam selesai shift (HH:mm)"
    },
    "status": {
      "type": "string",
      "enum": [
        "hadir",
        "izin",
        "sakit"
      ],
      "default": "hadir"
    },
    "notes": {
      "type": "string"
    },
    "excluded_from_reports": {
      "type": "boolean",
      "default": false,
      "description": "Dikecualikan dari laporan (owner only)"
    },
    "is_test_data": {
      "type": "boolean",
      "default": false,
      "description": "Ditandai sebagai data test \u2014 tidak masuk laporan"
    }
  },
  "required": [
    "employee_name",
    "employee_email",
    "date",
    "check_in",
    "status"
  ]
}