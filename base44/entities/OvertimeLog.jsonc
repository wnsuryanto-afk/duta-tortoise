{
  "name": "OvertimeLog",
  "type": "object",
  "properties": {
    "employee_id": {
      "type": "string",
      "description": "ID karyawan"
    },
    "employee_name": {
      "type": "string",
      "description": "Nama karyawan"
    },
    "employee_email": {
      "type": "string",
      "description": "Email karyawan"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Tanggal lembur"
    },
    "hours": {
      "type": "number",
      "description": "Jumlah jam lembur"
    },
    "notes": {
      "type": "string",
      "description": "Catatan / alasan lembur"
    },
    "approved_by": {
      "type": "string",
      "description": "Disetujui oleh"
    }
  },
  "required": [
    "employee_name",
    "employee_email",
    "date",
    "hours"
  ]
}