{
  "name": "VetContact",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nama dokter hewan"
    },
    "clinic_name": {
      "type": "string",
      "description": "Nama klinik/RS hewan"
    },
    "hp_whatsapp": {
      "type": "string",
      "description": "Nomor HP/WhatsApp"
    },
    "email": {
      "type": "string",
      "description": "Email"
    },
    "address": {
      "type": "string",
      "description": "Alamat klinik"
    },
    "area": {
      "type": "string",
      "enum": [
        "kraksaan",
        "probolinggo_kota",
        "dringu",
        "paiton",
        "besuk",
        "gending",
        "pajarakan",
        "tongas",
        "lumbang",
        "surabaya",
        "malang",
        "pasuruan",
        "situbondo",
        "jember",
        "banyuwangi",
        "lainnya"
      ],
      "default": "probolinggo_kota",
      "description": "Wilayah/area klinik"
    },
    "specialization": {
      "type": "string",
      "description": "Spesialisasi (Reptil, Eksotik, Umum, Bedah, Lainnya)"
    },
    "availability": {
      "type": "string",
      "description": "Jam operasional"
    },
    "emergency_available": {
      "type": "boolean",
      "default": false,
      "description": "Bisa dipanggil darurat"
    },
    "consultation_fee": {
      "type": "number",
      "description": "Perkiraan biaya konsultasi"
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "Rating internal (1-5)"
    },
    "last_consulted": {
      "type": "string",
      "format": "date",
      "description": "Tanggal konsultasi terakhir"
    },
    "total_consultations": {
      "type": "number",
      "default": 0,
      "description": "Total konsultasi"
    },
    "notes": {
      "type": "string",
      "description": "Catatan internal"
    },
    "is_preferred": {
      "type": "boolean",
      "default": false,
      "description": "Dokter andalan"
    }
  },
  "required": [
    "name",
    "hp_whatsapp"
  ]
}