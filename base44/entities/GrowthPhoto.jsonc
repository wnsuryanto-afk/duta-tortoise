{
  "name": "GrowthPhoto",
  "type": "object",
  "properties": {
    "tortoise_id": {
      "type": "string",
      "description": "ID kura-kura"
    },
    "tortoise_name": {
      "type": "string",
      "description": "Nama kura-kura"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Tanggal foto"
    },
    "photo_url": {
      "type": "string",
      "description": "URL foto"
    },
    "weight_grams": {
      "type": "number",
      "description": "Berat saat foto (gram)"
    },
    "shell_length_cm": {
      "type": "number",
      "description": "Panjang cangkang (cm)"
    },
    "age_months": {
      "type": "number",
      "description": "Usia dalam bulan saat foto"
    },
    "taken_by": {
      "type": "string",
      "description": "Nama yang mengambil foto"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "tortoise_id",
    "tortoise_name",
    "date",
    "photo_url"
  ]
}