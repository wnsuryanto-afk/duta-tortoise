{
  "name": "CompanySettings",
  "type": "object",
  "properties": {
    "company_name": {
      "type": "string",
      "description": "Nama perusahaan untuk KOP surat"
    },
    "company_address": {
      "type": "string",
      "description": "Alamat perusahaan"
    },
    "company_city": {
      "type": "string",
      "description": "Kota"
    },
    "company_phone": {
      "type": "string",
      "description": "Nomor telepon"
    },
    "company_email": {
      "type": "string",
      "description": "Email perusahaan"
    },
    "company_logo_url": {
      "type": "string",
      "description": "URL logo perusahaan"
    },
    "director_name": {
      "type": "string",
      "description": "Nama direktur / pimpinan untuk tanda tangan"
    },
    "director_title": {
      "type": "string",
      "description": "Jabatan direktur / pimpinan",
      "default": "Pimpinan"
    },
    "min_poin_bulanan": {
      "type": "number",
      "default": 300,
      "description": "Target minimum poin per bulan per karyawan"
    },
    "nilai_per_poin": {
      "type": "number",
      "default": 500,
      "description": "Nilai rupiah per poin untuk bonus gaji"
    },
    "farm_lat": {
      "type": "number",
      "description": "Latitude lokasi kandang"
    },
    "farm_lng": {
      "type": "number",
      "description": "Longitude lokasi kandang"
    },
    "farm_location_radius": {
      "type": "number",
      "default": 200,
      "description": "Radius toleransi checkout dalam meter"
    },
    "setting_key": {
      "type": "string",
      "default": "main",
      "description": "Key unik (selalu 'main') untuk single-record pattern"
    },
    "stok_approval_threshold": {
      "type": "number",
      "default": 500000,
      "description": "Nilai minimum stok keluar yang memerlukan approval (Rp)"
    },
    "test_mode_active": {
      "type": "boolean",
      "default": false,
      "description": "Mode testing aktif \u2014 semua data baru akan ditandai is_test_data=true"
    },
    "test_mode_started_at": {
      "type": "string",
      "format": "date-time",
      "description": "Waktu test mode diaktifkan"
    },
    "test_mode_started_by": {
      "type": "string",
      "description": "Email user yang mengaktifkan test mode"
    },
    "hpp_fallback_per_ekor": {
      "type": "number",
      "default": 100000,
      "description": "Fallback biaya perawatan per ekor per bulan jika belum ada data pengeluaran (Rp)"
    },
    "hpp_include_salary": {
      "type": "boolean",
      "default": true,
      "description": "Sertakan gaji dalam perhitungan biaya per ekor untuk HPP"
    }
  },
  "required": [
    "company_name"
  ]
}