{
  "name": "CompanySettings",
  "type": "object",
  "properties": {
    "company_name": {
      "type": "string",
      "description": "Nama perusahaan untuk KOP surat"
    },
    "company_address": {
      "type": "string",
      "description": "Alamat perusahaan"
    },
    "company_city": {
      "type": "string",
      "description": "Kota"
    },
    "company_phone": {
      "type": "string",
      "description": "Nomor telepon"
    },
    "company_email": {
      "type": "string",
      "description": "Email perusahaan"
    },
    "company_logo_url": {
      "type": "string",
      "description": "URL logo perusahaan"
    },
    "director_name": {
      "type": "string",
      "description": "Nama direktur / pimpinan untuk tanda tangan"
    },
    "director_title": {
      "type": "string",
      "description": "Jabatan direktur / pimpinan",
      "default": "Pimpinan"
    },
    "min_poin_bulanan": {
      "type": "number",
      "default": 300,
      "description": "Target minimum poin per bulan per karyawan. Dipakai sebagai tingkat DASAR bila target bertingkat belum diisi."
    },
    "target_poin_tim": {
      "type": "number",
      "description": "D16 - Total poin SELURUH tim dalam sebulan yang membuka bonus tingkat Dasar. Dibuat bersama karena poin yang tersedia terbatas dan dibagi antar kiper: target Dasar perorangan membuat kiper berebut tugas, karena menaikkan poin sendiri berarti menurunkan poin rekannya. Ambang pribadi min_poin_bulanan tetap berlaku sebagai lantai agar tidak ada yang menumpang penuh pada kerja rekan."
    },
    "target_poin_bagus": {
      "type": "number",
      "description": "B1 - Tingkat kedua: poin per bulan untuk bonus 'Bagus'. Harus di atas min_poin_bulanan."
    },
    "target_poin_luar_biasa": {
      "type": "number",
      "description": "B1 - Tingkat ketiga: poin per bulan untuk bonus 'Luar biasa'."
    },
    "bonus_dasar": {
      "type": "number",
      "default": 0,
      "description": "B1 - Rupiah bonus sekali bayar bila tingkat Dasar tercapai. 0 = belum diisi owner."
    },
    "bonus_bagus": {
      "type": "number",
      "default": 0,
      "description": "B1 - Rupiah bonus sekali bayar bila tingkat Bagus tercapai."
    },
    "bonus_luar_biasa": {
      "type": "number",
      "default": 0,
      "description": "B1 - Rupiah bonus sekali bayar bila tingkat Luar biasa tercapai."
    },
    "nilai_per_poin": {
      "type": "number",
      "default": 500,
      "description": "Nilai rupiah per poin untuk bonus gaji"
    },
    "farm_lat": {
      "type": "number",
      "description": "Latitude lokasi kandang"
    },
    "farm_lng": {
      "type": "number",
      "description": "Longitude lokasi kandang"
    },
    "farm_location_radius": {
      "type": "number",
      "default": 200,
      "description": "Radius toleransi checkout dalam meter"
    },
    "setting_key": {
      "type": "string",
      "default": "main",
      "description": "Key unik (selalu 'main') untuk single-record pattern"
    },
    "stok_approval_threshold": {
      "type": "number",
      "default": 500000,
      "description": "Nilai minimum stok keluar yang memerlukan approval (Rp)"
    },
    "auto_overtime_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Hitung lembur otomatis dari jam check-in/out. Bila false, jam lembur diisi manual owner/admin di slip."
    },
    "poin_bonus_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Aktifkan bonus poin menjadi uang. Bawaan MATI \u2014 poin tetap dicatat sebagai pencapaian tetapi tidak dibayar sampai dinyalakan."
    },
    "test_mode_active": {
      "type": "boolean",
      "default": false,
      "description": "Mode testing aktif \u2014 semua data baru akan ditandai is_test_data=true"
    },
    "test_mode_started_at": {
      "type": "string",
      "format": "date-time",
      "description": "Waktu test mode diaktifkan"
    },
    "test_mode_started_by": {
      "type": "string",
      "description": "Email user yang mengaktifkan test mode"
    },
    "hpp_fallback_per_ekor": {
      "type": "number",
      "default": 100000,
      "description": "Fallback biaya perawatan per ekor per bulan jika belum ada data pengeluaran (Rp)"
    },
    "hpp_include_salary": {
      "type": "boolean",
      "default": true,
      "description": "Sertakan gaji dalam perhitungan biaya per ekor untuk HPP"
    },
    "ai_vision_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Aktifkan AI Vision keseluruhan untuk verifikasi foto task. Jika false, foto tidak dianalisis AI."
    },
    "ai_saran_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Saran AI (apresiasi + saran membangun) ditampilkan ke keeper. Jika false, keeper tidak melihat saran AI (penilaian teknis tetap untuk owner)."
    }
  },
  "required": [
    "company_name"
  ]
}