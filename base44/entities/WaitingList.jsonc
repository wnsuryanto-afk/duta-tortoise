{
  "name": "WaitingList",
  "type": "object",
  "properties": {
    "buyer_name": {
      "type": "string",
      "description": "Nama calon pembeli"
    },
    "buyer_phone": {
      "type": "string",
      "description": "Nomor telepon"
    },
    "buyer_whatsapp": {
      "type": "string",
      "description": "Nomor WhatsApp"
    },
    "request_date": {
      "type": "string",
      "format": "date",
      "description": "Tanggal indent"
    },
    "desired_morph": {
      "type": "string",
      "description": "Morph yang diinginkan"
    },
    "desired_gender": {
      "type": "string",
      "enum": [
        "jantan",
        "betina",
        "semua"
      ],
      "description": "Gender yang diinginkan"
    },
    "max_budget": {
      "type": "number",
      "description": "Budget maksimal (Rp)"
    },
    "quantity": {
      "type": "number",
      "default": 1,
      "description": "Jumlah yang diinginkan"
    },
    "status": {
      "type": "string",
      "enum": [
        "menunggu",
        "ditawarkan",
        "deal",
        "batal"
      ],
      "default": "menunggu"
    },
    "notes": {
      "type": "string"
    },
    "followed_up_date": {
      "type": "string",
      "format": "date",
      "description": "Tanggal terakhir follow up"
    }
  },
  "required": [
    "buyer_name",
    "buyer_phone",
    "request_date"
  ]
}