{
  "name": "FeedbackSuggestion",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "kritik",
        "saran",
        "pertanyaan"
      ],
      "default": "saran",
      "description": "Jenis feedback"
    },
    "title": {
      "type": "string",
      "description": "Judul"
    },
    "content": {
      "type": "string",
      "description": "Isi kritik/saran"
    },
    "submitted_by_name": {
      "type": "string",
      "description": "Nama pengirim"
    },
    "submitted_by_email": {
      "type": "string",
      "description": "Email pengirim"
    },
    "status": {
      "type": "string",
      "enum": [
        "baru",
        "diproses",
        "selesai"
      ],
      "default": "baru",
      "description": "Status penanganan"
    },
    "response": {
      "type": "string",
      "description": "Balasan dari admin/owner"
    },
    "is_anonymous": {
      "type": "boolean",
      "default": false,
      "description": "Anonim"
    }
  },
  "required": [
    "content",
    "type"
  ]
}