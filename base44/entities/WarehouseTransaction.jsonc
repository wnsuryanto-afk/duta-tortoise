{
  "name": "WarehouseTransaction",
  "type": "object",
  "properties": {
    "item_id": {
      "type": "string"
    },
    "item_name": {
      "type": "string"
    },
    "item_code": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "masuk",
        "keluar"
      ]
    },
    "quantity": {
      "type": "number"
    },
    "unit": {
      "type": "string"
    },
    "unit_price": {
      "type": "number",
      "default": 0
    },
    "total_price": {
      "type": "number",
      "default": 0
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    },
    "created_by_name": {
      "type": "string"
    }
  },
  "required": [
    "item_name",
    "type",
    "quantity",
    "date",
    "unit",
    "created_by_name"
  ]
}