{
  "name": "WarehouseTransaction",
  "type": "object",
  "properties": {
    "item_id": {
      "type": "string",
      "description": "ID barang"
    },
    "item_name": {
      "type": "string",
      "description": "Nama barang"
    },
    "item_code": {
      "type": "string",
      "description": "Kode barang"
    },
    "type": {
      "type": "string",
      "enum": [
        "masuk",
        "keluar"
      ],
      "description": "Jenis transaksi"
    },
    "quantity": {
      "type": "number",
      "description": "Jumlah"
    },
    "unit": {
      "type": "string",
      "description": "Satuan"
    },
    "unit_price": {
      "type": "number",
      "default": 0,
      "description": "Harga per satuan saat transaksi"
    },
    "total_price": {
      "type": "number",
      "default": 0,
      "description": "Total harga (qty x unit_price)"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Tanggal transaksi"
    },
    "notes": {
      "type": "string",
      "description": "Catatan / keperluan"
    },
    "created_by_name": {
      "type": "string",
      "description": "Nama pencatat"
    }
  },
  "required": [
    "item_name",
    "type",
    "quantity",
    "date"
  ]
}