{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "owner",
        "manajer",
        "admin",
        "kepala_feeder",
        "keeper",
        "viewer"
      ],
      "default": "keeper",
      "description": "Role pengguna dalam sistem"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Apakah akun aktif"
    },
    "photo_url": {
      "type": "string",
      "description": "Foto profil"
    },
    "last_login": {
      "type": "string",
      "format": "date-time",
      "description": "Terakhir login"
    }
  },
  "required": [
    "role"
  ]
}