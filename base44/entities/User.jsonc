{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "owner",
        "admin",
        "manajer",
        "kepala_feeder",
        "keeper",
        "investor",
        "viewer"
      ],
      "default": "keeper",
      "description": "Peran pengguna dalam peternakan"
    }
  },
  "required": [
    "role"
  ]
}