{
  "name": "SalarySlip",
  "type": "object",
  "properties": {
    "employee_id": {
      "type": "string",
      "description": "ID user karyawan"
    },
    "employee_email": {
      "type": "string",
      "description": "Email karyawan"
    },
    "employee_name": {
      "type": "string",
      "description": "Nama karyawan (snapshot) \u2014 tampilan utama di-resolve dari User"
    },
    "employee_role": {
      "type": "string",
      "description": "Role karyawan"
    },
    "period_type": {
      "type": "string",
      "enum": [
        "weekly",
        "monthly"
      ],
      "default": "monthly",
      "description": "Jenis periode slip: weekly (Minggu\u2013Sabtu) atau bulanan"
    },
    "period": {
      "type": "string",
      "description": "Periode gaji: YYYY-MM (bulanan) atau YYYY-MM-DD = week_start (mingguan)"
    },
    "week_start": {
      "type": "string",
      "format": "date",
      "description": "Tanggal Minggu (awal minggu) untuk slip mingguan"
    },
    "week_end": {
      "type": "string",
      "format": "date",
      "description": "Tanggal Sabtu (akhir minggu) untuk slip mingguan"
    },
    "attend_days": {
      "type": "number",
      "default": 0,
      "description": "Jumlah hari hadir dalam periode"
    },
    "base_salary": {
      "type": "number",
      "default": 0,
      "description": "Gaji pokok = hari hadir \u00d7 tarif harian"
    },
    "kpi_bonus": {
      "type": "number",
      "default": 0,
      "description": "Bonus KPI"
    },
    "overtime_pay": {
      "type": "number",
      "default": 0,
      "description": "Total lembur = jam lembur \u00d7 tarif lembur"
    },
    "vegetable_pay": {
      "type": "number",
      "default": 0,
      "description": "(Legacy) total upah ambil sayur"
    },
    "vegetable_trips": {
      "type": "number",
      "default": 0,
      "description": "(Legacy) jumlah trip ambil sayur"
    },
    "vegetable_trip_dates": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "(Legacy) tanggal trip ambil sayur"
    },
    "rempesan_pay": {
      "type": "number",
      "default": 0,
      "description": "Total upah rempesan minggu ini"
    },
    "rempesan_trips": {
      "type": "number",
      "default": 0,
      "description": "Jumlah trip rempesan (maks 1 per hari)"
    },
    "rempesan_dates": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tanggal-tanggal rempesan untuk dicocokkan"
    },
    "absent_deduction": {
      "type": "number",
      "default": 0,
      "description": "Potongan absensi"
    },
    "kasbon_deduction": {
      "type": "number",
      "default": 0,
      "description": "Potongan kasbon periode ini (hasil konfirmasi owner)"
    },
    "kasbon_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "ID Kasbon yang dipotong di slip ini"
    },
    "kasbon_plan": {
      "type": "array",
      "description": "Rencana potongan kasbon per kasbon hasil konfirmasi owner saat slip dibuat",
      "items": {
        "type": "object",
        "properties": {
          "kasbon_id": {
            "type": "string"
          },
          "amount": {
            "type": "number",
            "description": "Nominal yang dipotong (0 bila dilewati)"
          },
          "skip_reason": {
            "type": "string",
            "description": "Alasan bila dilewati minggu itu"
          }
        }
      }
    },
    "kasbon_remaining": {
      "type": "number",
      "default": 0,
      "description": "Sisa kasbon setelah potongan periode ini"
    },
    "total_poin": {
      "type": "number",
      "default": 0,
      "description": "Total poin karyawan periode ini"
    },
    "nilai_poin_saat_itu": {
      "type": "number",
      "default": 0,
      "description": "Snapshot nilai rupiah per poin yang dipakai saat slip dibuat \u2014 tidak berubah surut meski pengaturan diubah"
    },
    "target_poin_saat_itu": {
      "type": "number",
      "description": "Snapshot target poin minimum yang berlaku saat slip dibuat \u2014 supaya penilaian \"Tercapai\" pada slip lama tidak berubah saat targetnya diubah."
    },
    "poin_bonus": {
      "type": "number",
      "default": 0,
      "description": "Bonus dari poin (total_poin \u00d7 nilai_poin_saat_itu)"
    },
    "poin_deduction": {
      "type": "number",
      "default": 0,
      "description": "Potongan jika di bawah target minimum"
    },
    "poin_status": {
      "type": "string",
      "description": "Tercapai / Kurang N poin"
    },
    "gross_total": {
      "type": "number",
      "description": "Total bruto (sebelum potongan)"
    },
    "net_total": {
      "type": "number",
      "description": "Total neto / take home pay"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "approved",
        "paid"
      ],
      "default": "draft",
      "description": "draft \u2192 approved (diperiksa admin) \u2192 paid (dibayar owner)"
    },
    "approved_by": {
      "type": "string",
      "description": "Nama yang menandai diperiksa"
    },
    "approved_date": {
      "type": "string",
      "format": "date",
      "description": "Tanggal ditandai diperiksa"
    },
    "generated_by": {
      "type": "string",
      "description": "Nama yang membuat slip"
    },
    "paid_date": {
      "type": "string",
      "format": "date",
      "description": "Tanggal dibayarkan"
    },
    "paid_by": {
      "type": "string",
      "description": "Dibayarkan oleh"
    },
    "payment_proof_url": {
      "type": "string",
      "description": "URL bukti transfer gaji (screenshot m-banking)"
    },
    "payment_proof_uploaded_at": {
      "type": "string",
      "format": "date-time",
      "description": "Waktu upload bukti transfer"
    },
    "payment_proof_uploaded_by": {
      "type": "string",
      "description": "Nama yang mengupload bukti transfer"
    },
    "finance_tx_id": {
      "type": "string",
      "description": "ID FinanceTransaction otomatis saat paid"
    },
    "generated_date": {
      "type": "string",
      "format": "date",
      "description": "Tanggal slip dibuat"
    },
    "pdf_url": {
      "type": "string",
      "description": "Link PDF slip gaji yang dicetak"
    },
    "notes": {
      "type": "string"
    },
    "excluded_from_reports": {
      "type": "boolean",
      "default": false,
      "description": "Dikecualikan dari laporan (owner only)"
    },
    "is_test_data": {
      "type": "boolean",
      "default": false,
      "description": "Slip dibuat saat Mode Uji. Perhitungan HPP sudah menyaringnya, tetapi field-nya belum pernah ada sehingga penyaringannya tidak pernah berpengaruh."
    }
  },
  "required": [
    "employee_email",
    "employee_name",
    "period",
    "net_total"
  ]
}