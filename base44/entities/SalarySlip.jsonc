{
  "name": "SalarySlip",
  "type": "object",
  "properties": {
    "employee_id": {
      "type": "string",
      "description": "ID user karyawan"
    },
    "employee_email": {
      "type": "string",
      "description": "Email karyawan"
    },
    "employee_name": {
      "type": "string",
      "description": "Nama karyawan"
    },
    "employee_role": {
      "type": "string",
      "description": "Role karyawan"
    },
    "period": {
      "type": "string",
      "description": "Periode gaji format YYYY-MM"
    },
    "base_salary": {
      "type": "number",
      "default": 0,
      "description": "Gaji pokok"
    },
    "kpi_bonus": {
      "type": "number",
      "default": 0,
      "description": "Bonus KPI"
    },
    "overtime_pay": {
      "type": "number",
      "default": 0,
      "description": "Total lembur"
    },
    "vegetable_pay": {
      "type": "number",
      "default": 0,
      "description": "Total upah ambil sayur"
    },
    "vegetable_trips": {
      "type": "number",
      "default": 0,
      "description": "Jumlah trip ambil sayur (1 trip = 1 hari ambil sayur pasar/campur)"
    },
    "vegetable_trip_dates": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Daftar tanggal trip ambil sayur untuk transparansi"
    },
    "absent_deduction": {
      "type": "number",
      "default": 0,
      "description": "Potongan absensi"
    },
    "kasbon_deduction": {
      "type": "number",
      "default": 0,
      "description": "Potongan kasbon periode ini"
    },
    "kasbon_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "ID Kasbon yang dipotong di slip ini"
    },
    "kasbon_remaining": {
      "type": "number",
      "default": 0,
      "description": "Sisa kasbon setelah potongan periode ini"
    },
    "total_poin": {
      "type": "number",
      "default": 0,
      "description": "Total poin karyawan periode ini"
    },
    "poin_bonus": {
      "type": "number",
      "default": 0,
      "description": "Bonus dari poin (total_poin \u00d7 nilai_per_poin)"
    },
    "poin_deduction": {
      "type": "number",
      "default": 0,
      "description": "Potongan jika di bawah target minimum"
    },
    "poin_status": {
      "type": "string",
      "description": "Tercapai / Kurang N poin"
    },
    "gross_total": {
      "type": "number",
      "description": "Total bruto (sebelum potongan)"
    },
    "net_total": {
      "type": "number",
      "description": "Total neto / take home pay"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "approved",
        "paid"
      ],
      "default": "draft"
    },
    "paid_date": {
      "type": "string",
      "format": "date",
      "description": "Tanggal dibayarkan"
    },
    "paid_by": {
      "type": "string",
      "description": "Dibayarkan oleh"
    },
    "finance_tx_id": {
      "type": "string",
      "description": "ID FinanceTransaction otomatis saat paid"
    },
    "generated_date": {
      "type": "string",
      "format": "date",
      "description": "Tanggal slip dibuat"
    },
    "pdf_url": {
      "type": "string",
      "description": "Link PDF slip gaji yang dicetak"
    },
    "notes": {
      "type": "string"
    },
    "excluded_from_reports": {
      "type": "boolean",
      "default": false,
      "description": "Dikecualikan dari laporan (owner only)"
    }
  },
  "required": [
    "employee_email",
    "employee_name",
    "period",
    "net_total"
  ]
}