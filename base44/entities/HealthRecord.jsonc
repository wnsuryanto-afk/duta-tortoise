{
  "name": "HealthRecord",
  "type": "object",
  "properties": {
    "tortoise_id": {
      "type": "string",
      "description": "ID tortoise"
    },
    "tortoise_name": {
      "type": "string",
      "description": "Nama tortoise"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Tanggal pemeriksaan"
    },
    "type": {
      "type": "string",
      "enum": [
        "checkup",
        "sakit",
        "obat",
        "vaksin",
        "timbang",
        "lainnya"
      ],
      "default": "checkup",
      "description": "Jenis catatan"
    },
    "weight_grams": {
      "type": "number",
      "description": "Berat saat pemeriksaan (gram)"
    },
    "shell_length_cm": {
      "type": "number",
      "description": "Panjang cangkang (cm)"
    },
    "temperature_C": {
      "type": "number",
      "description": "Suhu tubuh kura-kura saat pemeriksaan (\u00b0C)"
    },
    "description": {
      "type": "string",
      "description": "Deskripsi kondisi/tindakan"
    },
    "treatment": {
      "type": "string",
      "description": "Penanganan/obat yang diberikan"
    },
    "vet_name": {
      "type": "string",
      "description": "Nama dokter hewan"
    },
    "photo_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Foto kondisi kesehatan"
    },
    "follow_up_date": {
      "type": "string",
      "format": "date",
      "description": "Tanggal kontrol berikutnya"
    }
  },
  "required": [
    "tortoise_name",
    "date",
    "type"
  ]
}