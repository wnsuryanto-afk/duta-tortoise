{
  "name": "HealthRecord",
  "type": "object",
  "properties": {
    "tortoise_id": {
      "type": "string",
      "description": "ID tortoise"
    },
    "tortoise_name": {
      "type": "string",
      "description": "Nama tortoise"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Tanggal pemeriksaan"
    },
    "type": {
      "type": "string",
      "enum": [
        "checkup",
        "sakit",
        "obat",
        "vaksin",
        "timbang",
        "lainnya"
      ],
      "default": "checkup",
      "description": "Jenis catatan"
    },
    "diagnosis": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "infeksi_saluran_pernapasan",
          "rns",
          "pneumonia",
          "shell_rot",
          "pyramiding",
          "retak_cangkang",
          "infeksi_jamur_cangkang",
          "mbd",
          "hipovitaminosis_a",
          "gout",
          "batu_kandung_kemih",
          "sembelit",
          "diare",
          "anorexia",
          "cacingan",
          "protozoa",
          "tungau_kutu",
          "luka_gigitan",
          "abses",
          "infeksi_jamur_kulit",
          "infeksi_mata",
          "stomatitis",
          "abses_telinga",
          "prolaps",
          "prolaps_penis",
          "egg_binding",
          "edema",
          "dehidrasi",
          "heat_stroke",
          "stres",
          "checkup_rutin",
          "lainnya"
        ]
      },
      "description": "Daftar diagnosis (multi-pilih)"
    },
    "severity": {
      "type": "string",
      "enum": [
        "ringan",
        "sedang",
        "berat",
        "kritis"
      ],
      "description": "Tingkat keparahan"
    },
    "diagnosis_notes": {
      "type": "string",
      "description": "Catatan tambahan per diagnosis"
    },
    "temperature_C": {
      "type": "number",
      "description": "Suhu tubuh kura-kura saat pemeriksaan (\u00b0C)"
    },
    "description": {
      "type": "string",
      "description": "Deskripsi kondisi/tindakan"
    },
    "treatment": {
      "type": "string",
      "description": "Catatan tindakan tambahan (rendam, dll)"
    },
    "treatment_items": {
      "type": "array",
      "description": "Obat & perlengkapan yang digunakan (terhubung ke stok gudang)",
      "items": {
        "type": "object",
        "properties": {
          "item_id": {
            "type": "string",
            "description": "ID WarehouseItem"
          },
          "item_name": {
            "type": "string"
          },
          "item_sku": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          },
          "unit_price": {
            "type": "number"
          },
          "subtotal": {
            "type": "number"
          }
        }
      }
    },
    "biaya_obat": {
      "type": "number",
      "default": 0,
      "description": "Biaya obat/treatment (Rp) - dihitung otomatis dari treatment_items, atau manual jika treatment_items kosong"
    },
    "biaya_obat_manual": {
      "type": "boolean",
      "default": false,
      "description": "true jika biaya_obat diisi manual (override otomatis)"
    },
    "finance_tx_id": {
      "type": "string",
      "description": "ID FinanceTransaction yang dibuat otomatis"
    },
    "vet_name": {
      "type": "string",
      "description": "Nama dokter hewan"
    },
    "photo_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Foto kondisi kesehatan"
    },
    "photo_docs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Foto dokumentasi diagnosis"
    },
    "follow_up_date": {
      "type": "string",
      "format": "date",
      "description": "Tanggal kontrol berikutnya"
    }
  },
  "required": [
    "tortoise_name",
    "date",
    "type"
  ]
}