{
  "name": "WarningLetter",
  "type": "object",
  "properties": {
    "employee_id": {
      "type": "string"
    },
    "employee_name": {
      "type": "string"
    },
    "employee_email": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "level": {
      "type": "string",
      "enum": [
        "SP1",
        "SP2",
        "SP3"
      ]
    },
    "reason": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "issued_by": {
      "type": "string"
    },
    "acknowledged": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "employee_name",
    "employee_email",
    "date",
    "level",
    "reason",
    "issued_by",
    "description"
  ]
}