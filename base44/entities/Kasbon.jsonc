{
  "name": "Kasbon",
  "type": "object",
  "properties": {
    "employee_id": {
      "type": "string"
    },
    "employee_name": {
      "type": "string"
    },
    "employee_email": {
      "type": "string"
    },
    "amount": {
      "type": "number",
      "description": "Total nominal kasbon yang dipinjam"
    },
    "request_date": {
      "type": "string",
      "format": "date"
    },
    "reason": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "lunas"
      ],
      "default": "pending"
    },
    "weekly_deduction": {
      "type": "number",
      "default": 100000,
      "description": "Potongan per periode gaji (default Rp 100.000)"
    },
    "total_paid": {
      "type": "number",
      "default": 0,
      "description": "Total yang sudah dibayar/dipotong"
    },
    "approved_by": {
      "type": "string"
    },
    "approved_date": {
      "type": "string",
      "format": "date"
    },
    "deduction_log": {
      "type": "array",
      "description": "Riwayat potongan/pembayaran kasbon",
      "items": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "number",
            "description": "Nominal potongan/pembayaran"
          },
          "date": {
            "type": "string",
            "format": "date",
            "description": "Tanggal potongan"
          },
          "method": {
            "type": "string",
            "enum": [
              "manual",
              "salary_slip",
              "cash"
            ],
            "description": "manual = catat potongan, salary_slip = dipotong dari slip gaji, cash = pelunasan tunai"
          },
          "salary_period": {
            "type": "string",
            "description": "Periode gaji (YYYY-MM) jika dipotong via slip"
          },
          "salary_slip_id": {
            "type": "string",
            "description": "ID slip gaji jika dipotong via slip (anti-dobel potong)"
          },
          "recorded_by": {
            "type": "string",
            "description": "Nama yang mencatat"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "finance_tx_id": {
      "type": "string",
      "description": "ID FinanceTransaction pengeluaran saat kasbon dicairkan (opsional)"
    },
    "notes": {
      "type": "string"
    },
    "excluded_from_reports": {
      "type": "boolean",
      "default": false,
      "description": "Dikecualikan dari laporan (owner only)"
    },
    "is_test_data": {
      "type": "boolean",
      "default": false,
      "description": "Ditandai sebagai data test \u2014 tidak masuk laporan"
    }
  },
  "required": [
    "employee_name",
    "employee_email",
    "amount",
    "request_date",
    "reason"
  ]
}