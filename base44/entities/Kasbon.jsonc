{
  "name": "Kasbon",
  "type": "object",
  "properties": {
    "employee_id": {
      "type": "string"
    },
    "employee_name": {
      "type": "string"
    },
    "employee_email": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "request_date": {
      "type": "string",
      "format": "date"
    },
    "reason": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "lunas"
      ],
      "default": "pending"
    },
    "weekly_deduction": {
      "type": "number",
      "default": 100000
    },
    "total_paid": {
      "type": "number",
      "default": 0
    },
    "approved_by": {
      "type": "string"
    },
    "approved_date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "employee_name",
    "employee_email",
    "amount",
    "request_date",
    "reason"
  ]
}