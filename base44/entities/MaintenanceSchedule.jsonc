{
  "name": "MaintenanceSchedule",
  "type": "object",
  "properties": {
    "enclosure_name": {
      "type": "string",
      "description": "Nama kandang"
    },
    "task_type": {
      "type": "string",
      "enum": [
        "pakan",
        "kebersihan_harian",
        "kebersihan_mingguan",
        "kebersihan_bulanan"
      ],
      "description": "Jenis perawatan"
    },
    "frequency_days": {
      "type": "number",
      "description": "Frekuensi dalam hari (1, 7, 30)"
    },
    "scheduled_time": {
      "type": "string",
      "description": "Waktu pelaksanaan (HH:mm)"
    },
    "assigned_to": {
      "type": "string",
      "description": "Karyawan yang bertanggung jawab"
    },
    "tasks_checklist": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Checklist tugas"
    },
    "last_done": {
      "type": "string",
      "format": "date",
      "description": "Terakhir dilakukan"
    },
    "next_due": {
      "type": "string",
      "format": "date",
      "description": "Jadwal berikutnya (auto-calculated)"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "enclosure_name",
    "task_type"
  ],
  "description": "[USANG 31-08-2026] TIDAK DIPAKAI — barisnya ada tapi seluruhnya is_active: false, dan tidak ada kode yang bisa membuat atau mengaktifkannya. Pekerjaan berulang ditangani SOPTask, hasilnya dicatat ke MaintenanceLog (yang HIDUP, jangan ikut dianggap usang). Dibiarkan ada agar data lama tidak hilang; jangan dipakai untuk fitur baru."
}
