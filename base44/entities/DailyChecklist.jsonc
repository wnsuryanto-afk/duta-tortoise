{
  "name": "DailyChecklist",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date",
      "description": "Tanggal checklist"
    },
    "employee_id": {
      "type": "string",
      "description": "ID karyawan"
    },
    "employee_name": {
      "type": "string",
      "description": "Nama karyawan"
    },
    "employee_email": {
      "type": "string",
      "description": "Email karyawan"
    },
    "completed_tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string"
          },
          "task_title": {
            "type": "string"
          },
          "points": {
            "type": "number"
          },
          "notes": {
            "type": "string"
          },
          "recorded_at": {
            "type": "string",
            "description": "Jam pencatatan task (HH:mm WIB) \u2014 untuk ditampilkan di Approval Poin & deteksi centang beruntun"
          },
          "photo_url": {
            "type": "string",
            "description": "URL bukti foto penyelesaian task"
          },
          "photo_taken_at": {
            "type": "string",
            "description": "Jam pengambilan foto (HH:mm)"
          },
          "photo_notes": {
            "type": "string",
            "description": "Catatan keeper saat upload foto bukti (opsional)"
          },
          "status": {
            "type": "string",
            "enum": [
              "completed",
              "skipped_no_stock"
            ],
            "default": "completed",
            "description": "completed = task dikerjakan, skipped_no_stock = dilewati karena stok kosong"
          },
          "skip_reason": {
            "type": "string",
            "description": "Alasan skip (mis: Stok kosong)"
          },
          "ai_verified": {
            "type": "boolean",
            "description": "Hasil AI Vision: true=foto sesuai task, false=tidak sesuai"
          },
          "ai_confidence": {
            "type": "number",
            "description": "Tingkat keyakinan AI (0-100)"
          },
          "ai_reason": {
            "type": "string",
            "description": "Alasan singkat dari AI (legacy, untuk owner badge)"
          },
          "ai_apresiasi": {
            "type": "string",
            "description": "Apresiasi positif dari AI untuk keeper (hangat & sopan)"
          },
          "ai_saran": {
            "type": "string",
            "description": "Saran membangun dari AI untuk keeper (1-2 kalimat, atau kosong jika sudah bagus)"
          },
          "ai_temuan_penting": {
            "type": "string",
            "description": "Temuan penting untuk owner (mis: kandang becek, kura lesu) \u2014 kosong jika tidak ada"
          },
          "ai_findings": {
            "type": "string",
            "description": "Legacy field \u2014 gunakan ai_temuan_penting"
          },
          "ai_status": {
            "type": "string",
            "enum": [
              "belum_diperiksa",
              "sedang_diproses",
              "selesai",
              "gagal"
            ],
            "description": "Status pemeriksaan AI: belum_diperiksa / sedang_diproses / selesai / gagal"
          },
          "ai_error": {
            "type": "string",
            "description": "Alasan jika analisis AI gagal (mis: gambar tidak terbaca / layanan sibuk)"
          },
          "photo_age_warning": {
            "type": "string",
            "description": "Peringatan jika foto berusia >2 jam (kemungkinan bukan diambil saat itu)"
          },
          "photo_time_warning": {
            "type": "string",
            "description": "Peringatan jika foto diambil di luar jam tugas"
          },
          "owner_note": {
            "type": "string",
            "description": "Catatan pribadi dari owner ke keeper (teks bebas)"
          }
        }
      },
      "description": "Daftar task yang diselesaikan"
    },
    "photo_proofs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string"
          },
          "photo_url": {
            "type": "string"
          },
          "taken_at": {
            "type": "string",
            "description": "Jam pengambilan foto (HH:mm)"
          }
        }
      },
      "description": "Bukti foto penyelesaian task"
    },
    "total_points_claimed": {
      "type": "number",
      "default": 0,
      "description": "Total poin yang diklaim"
    },
    "status": {
      "type": "string",
      "enum": [
        "submitted",
        "approved",
        "rejected"
      ],
      "default": "submitted",
      "description": "Status checklist"
    },
    "approved_by": {
      "type": "string",
      "description": "Nama admin yang approve"
    },
    "approved_points": {
      "type": "number",
      "default": 0,
      "description": "Poin yang disetujui admin"
    },
    "rejection_reason": {
      "type": "string",
      "description": "Alasan ditolak"
    },
    "notes": {
      "type": "string",
      "description": "Catatan tambahan"
    },
    "excluded_from_reports": {
      "type": "boolean",
      "default": false,
      "description": "Dikecualikan dari laporan (owner only)"
    },
    "is_test_data": {
      "type": "boolean",
      "default": false,
      "description": "Ditandai sebagai data test \u2014 tidak masuk laporan"
    }
  },
  "required": [
    "date",
    "employee_name",
    "employee_email"
  ]
}