{
  "name": "SOPDocument",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "perawatan_harian",
        "penanganan_sakit",
        "breeding",
        "karantina",
        "penjualan",
        "administrasi",
        "lainnya"
      ],
      "default": "lainnya"
    },
    "content": {
      "type": "string"
    },
    "photo_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "video_url": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "created_by": {
      "type": "string"
    },
    "last_updated": {
      "type": "string",
      "format": "date"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "title",
    "category",
    "content"
  ]
}