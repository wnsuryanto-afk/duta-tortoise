{
  "name": "IncidentalTask",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Judul tugas insidentil"
    },
    "assigned_to_email": {
      "type": "string",
      "description": "Email karyawan yang ditugaskan; kosong = siapa saja (keeper/kepala_feeder)"
    },
    "assigned_to_name": {
      "type": "string",
      "description": "Nama karyawan yang ditugaskan"
    },
    "points": {
      "type": "number",
      "default": 10,
      "description": "Poin untuk tugas ini"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "Tenggat: hari ini atau tanggal tertentu"
    },
    "notes": {
      "type": "string",
      "description": "Catatan/instruksi singkat (opsional)"
    },
    "photo_url": {
      "type": "string",
      "description": "Foto acuan (opsional, misal foto kran rusak)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "done",
        "cancelled"
      ],
      "default": "pending",
      "description": "pending = belum dikerjakan, done = sudah dikerjakan, cancelled = dibatalkan"
    },
    "required_items": {
      "type": "array",
      "description": "Daftar barang yang dibutuhkan untuk tugas ini (opsional)",
      "items": {
        "type": "object",
        "properties": {
          "item_name": {
            "type": "string",
            "description": "Nama barang"
          },
          "warehouse_item_id": {
            "type": "string",
            "description": "ID WarehouseItem jika dipilih dari katalog (opsional)"
          },
          "quantity": {
            "type": "number",
            "default": 1,
            "description": "Jumlah dibutuhkan"
          },
          "unit": {
            "type": "string",
            "description": "Satuan (pcs, buah, kg, dll)"
          },
          "notes": {
            "type": "string",
            "description": "Catatan khusus untuk barang ini"
          },
          "is_available": {
            "type": "boolean",
            "default": false,
            "description": "Apakah barang sudah tersedia/beli"
          },
          "marked_available_by": {
            "type": "string",
            "description": "Nama yang menandai barang sudah tersedia"
          },
          "marked_available_at": {
            "type": "string",
            "format": "date-time",
            "description": "Waktu ditandai tersedia"
          }
        }
      }
    },
    "material_status": {
      "type": "string",
      "enum": [
        "ready",
        "waiting_materials"
      ],
      "default": "ready",
      "description": "ready = siap dikerjakan (semua barang tersedia/tidak butuh barang), waiting_materials = ada barang belum tersedia"
    },
    "created_by_email": {
      "type": "string"
    },
    "created_by_name": {
      "type": "string"
    },
    "done_at": {
      "type": "string",
      "description": "Waktu dikerjakan (HH:mm)"
    },
    "done_date": {
      "type": "string",
      "format": "date",
      "description": "Tanggal dikerjakan"
    },
    "done_by_email": {
      "type": "string"
    },
    "done_by_name": {
      "type": "string"
    },
    "done_photo_url": {
      "type": "string",
      "description": "URL foto bukti penyelesaian tugas (dari keeper)"
    },
    "done_notes": {
      "type": "string",
      "description": "Catatan keeper saat menyelesaikan tugas"
    },
    "daily_checklist_id": {
      "type": "string",
      "description": "ID DailyChecklist tempat poin tugas ini diklaim (ikuti alur approval yang sudah ada)"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "false jika dibatalkan"
    }
  },
  "required": [
    "title",
    "points",
    "due_date",
    "status"
  ]
}