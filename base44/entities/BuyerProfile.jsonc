{
  "name": "BuyerProfile",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "hp_whatsapp": {
      "type": "string",
      "description": "Nomor HP/WhatsApp (format 08xxx atau 628xxx)"
    },
    "email": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "buyer_address": {
      "type": "string",
      "description": "Alamat lengkap pembeli"
    },
    "platform_asal": {
      "type": "string",
      "enum": [
        "Instagram",
        "Tokopedia",
        "Shopee",
        "WhatsApp",
        "Referral",
        "Langsung",
        "Lainnya"
      ]
    },
    "first_purchase_date": {
      "type": "string",
      "format": "date"
    },
    "last_purchase_date": {
      "type": "string",
      "format": "date"
    },
    "last_purchased_tortoise": {
      "type": "string",
      "description": "Kode kura terakhir yang dibeli"
    },
    "total_purchases": {
      "type": "number",
      "default": 0
    },
    "total_spent": {
      "type": "number",
      "default": 0
    },
    "favorite_morph": {
      "type": "string"
    },
    "budget_range": {
      "type": "string",
      "enum": [
        "<500rb",
        "500rb-1jt",
        "1jt-5jt",
        "5jt-10jt",
        ">10jt"
      ]
    },
    "tier": {
      "type": "string",
      "enum": [
        "baru",
        "reguler",
        "vip"
      ],
      "default": "baru"
    },
    "notes": {
      "type": "string"
    },
    "is_blacklist": {
      "type": "boolean",
      "default": false
    },
    "is_repeat_buyer": {
      "type": "boolean",
      "default": false,
      "description": "true jika total_purchases > 1"
    }
  },
  "required": [
    "name",
    "hp_whatsapp",
    "platform_asal"
  ]
}